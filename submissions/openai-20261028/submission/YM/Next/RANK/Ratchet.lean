variable {G : Gauge} {n : Side}
variable {C : Family G} {i k l j m p q d D a N : ℕ} {R : Lead G C.S p}
variable {c : Course C N p k} {ξ : Purse}
variable {P : (i : ℕ) → Rep G (C.side i p)} {X : AtlasData G C.S p}

lemma turnWheel (hX : Allowed C.path.levels ξ.band k) (H : Tally (wheel C.path.levels k) (clim C.path.levels k) ξ.era 2) {x : Points m} (hC : Crew c P R ξ x)
    (T : Config G (C.side N p) → veil (Fin m)) : Exhibits c P ξ.band x 2 c.allow T ξ.era := by
  intro j hj hp; dsimp only; intro M
  let A:= C.path.levels;let l:= middle A ξ.band k;let s:= clim A k; let z:=spouse s ξ.era (l-(j+1));
  have hk:z≤ Perch.bill (-1/2) s:= (partner ξ.era (show (l-(j+1)) ≤ more (wheel A k) s from (Nat.sub_le_sub_left (hj.trans (Nat.le_succ _)) l).trans_eq hX.shift)).trans H.growth
  obtain ⟨α,β,hα,hβ,H,K,h,hg,hL⟩:= M; rw [h]; exact (hC.vitality j hj hp).rent _ _ _ hα hβ H K z (spouse_pos ..|>.le) hk hL hg

variable (F : MarketGrant c P X R ξ)
variable (O : StampDuty C k N p d ξ.taylor (P k) ξ.era.coast.Q X)
variable {x : Points (m+1)} {e : ℝ} (H : C.Makes) (hp : C.ref d≤ k)

structure Launch (C : Family G) (k : ℕ) (ξ : Purse) (w e : ℝ) : Prop where
  pane : TableReady C k w (load ξ.era) ξ.era.coast.a
  year : Spindle.year C ξ.taylor k
  length : ξ.taylor+1 ≤ (C.path.levels.params k).order
  grant : Rocket ξ.f (load ξ.era) w ξ.era.coast.a ξ.goal ξ.era.coast.Q ξ.taylor e (clim C.path.levels k) (C.path.levels.params k)
  coup : Corridor C.path.levels ξ.band ξ k
  numbers (n : ℕ) : n≤2 → Awakening (G:=G) ξ (clim C.path.levels k) n

include F

end YM.Next.Rank.Tapes
