lemma salaryT (I: Medal G J T d (M0).order L vB vT M.p.kernel u v (B.target J T) (B.walls J T) (B.shape.o J T) (B.shape.μ J T) y ξ₀ z' (B.span J T)) (b: Support n₁) (f:Config G n₁→ℂ)(h:RegFit (K z) 0 d (hol G) b f)(c:ℝ)(hB:(K z).p.supBounds 0 b f c)(hZ:Bunk G vB vT d L u' z' ξ₀)(hu: 0<u')(hL:20*(radiusD y+Heir.reach y+1)<(n₀).val):
    let m₀:=(K z).p.mass b c; PaidAtom S! (Issue.trail V) N n m (hol G) (Extra.Histories.salary (K z) b f) 0 (sprite G y L ξ₀*m₀) (Doors.rate L*m₀):=by
    intro m₀; let P:= K z; let T':= Blush.float P 0 b h.anchor f c h.smooth hB h!; let W:=Blush.screen Z T' (pupil H z T'.live) (pupil H z T'.pale) v0 F; let r:= Blush.scope Z T' (0:Site n₀); let i:= Blush.found (0:Site n₁) b h.anchor; let V':= enter Z (icon Z i)
    have hz:= regularCard g hm hV hC hM hϕ hd hY hκ H z htw hew h! b c f h hB; change Fancy S! (Issue.trail V) N n m (hol G) _ r W 0 yT (Doors.rate L*m₀) _ at hz
    have hP': d ≤ T:=(Nat.le_add_right d 3).trans hd; have he:= livelyCard (d:=d) (n:=n) hY hP'; have ht : (R₀).p=B₁:=by rw [hew];rfl
    apply Nick.atom_lead S! (PathH) N n m (hol G) hz (V.choice.represents N n m hm.le) (ht.symm ▸ he)
    have hy: P.activities.reg i=reg (0:Site n₁) b h.anchor:= Blush.latch P 0 b h.anchor h!
    let m1:= sprite G y L z'; let T1:= Local.readPrice (hol G) F; let T0:= Motion.orbitCost F
    have h1:T'.live.turn= .logKey i:=rfl
    have hu₀: T'.live.crest=b:=by change (P.activities.reg i).support=b; rw [hy]
    have hb₀:r V'=(plate Z i).support:=by unfold r Blush.scope V'; rw [(enter Z).injective.extend_apply]; exact Mercury.grinchY Z T'.live i h1 _
    let X':=(plate Z i).support; let a:=(Local.weighted (hol G) F 0 X' t0 (Blush.pane Z T' v0 (icon Z i)))
    let R(j:ℕ):= W.row 0 r (hol G) (R₀).p.threshold j
    have hx: R V'=a :=by unfold R Local.Raw.row; rw[ht,hb₀]; change Local.weighted _ _ _ _ _ (stuff (enter Z) _ (enter Z _))= _; rw [stuffed]
    have h₃ : 1 ≤ T0 := Motion.orbitCost_one_le _
    let Q':=marvel (Q:=B.target J T) («L»:=D.L J) (x:=y) T'
    have hp₀:=ribbonW g hm hV hC H z hew hY hP' T' i h1 (hu₀.symm ▸ h.anchor) hz
    have hv₀:=show Motion.orbitCost F*(F).coeffSize ((0+ ∑' j,R j)-0) ≤ Motion.orbitCost F*((F).coeffSize a+ T1*(‖v0‖*(Q'+Q'))) from by
        rw [zero_add,← hx,sub_zero]
        exact (mul_le_mul_of_nonneg_left (by simpa only[sub_zero] using hp₀) (zero_le_one.trans h₃))
    let R(e:ℂ→L[ℝ]ℝ):= e ∘ f
    let Cors (e:ℂ→L[ℝ]ℝ)(hc:∀ i,‖e i‖ ≤ ‖i‖):=cove P 0 b h.anchor f c h.smooth hB e hc h!
    have hv(e:ℂ→L[ℝ]ℝ)(hc:∀ i,‖e i‖ ≤ ‖i‖) :
        (Cors e hc).ingredient=masked P.p.threshold (P.activities.reg i).support (R e)∧ (P.activities.reg i).site=(0:Site n₁)∧ P.p.Regular (P.activities.reg i).support (R e)∧ P.p.supBounds 0 (P.activities.reg i).support (R e) (Cors e hc).weight:=by
        rw [hy]; refine ⟨?_,rfl,readings e h.smooth,pricesL e h.smooth hc c hB⟩
        funext V; change e (masked P.p.threshold b f V)=masked P.p.threshold b (e ∘ f) V; by_cases hv:Healthy P.p.threshold b V; exact congr_arg e (masked_eq _ _ _ _ hv)|>.trans (masked_eq _ _ (e ∘ f) _ hv).symm; rw [masked_ne _ _ _ _ hv,map_zero, masked_ne _ _ _ _ hv];
    let x0:= m1*m₀
    let Yε:= T1*(‖v0‖*(Q'+Q')); have hT1:1≤ T1:= Local.readPrice_pos (hol G) F; have hG :0≤ m1:= (sprite_pos _ I.paid).le; have hmpos:m₀≥ 0:=hB.1.trans (P.p.loMass _ _ hB.1)
    have hCpool:Yε ≤ T1*(‖v0‖*(x0+x0)):=by
       apply mul_le_mul_of_nonneg_left _ (zero_le_one.trans hT1); have hh:= I.cloud n₁ P T'; rw [hu₀,show T'.live.weight=c from rfl] at hh; exact mul_le_mul_of_nonneg_left (add_le_add hh hh) (norm_nonneg _)
    apply hv₀.trans
    by_cases hh : coverNumber (B₁).B (plate Z i).support ≤ (B₁).B
    ·
       have heQ(e:ℂ→L[ℝ]ℝ)(hc:∀ i,‖e i‖≤‖i‖) {Zδ: Leaf P}(hf:Zδ=Cors e hc): let U:=matin Zδ Z (icon Z i) Chi.canonical; let fδ:=R e; let K:=dimW 0 (Malachite.radiusD y) (WaterLevels.forecast V m N n) fδ
        (B₁).Regular X' U∧ Nonwrapping X' 0 ∧ Push.Local.Chart d U 1 ∧ Push.Local.Chart d K 1 ∧ (∀ l:List (Directions G n₀),l.length≤d→(∀ A∈l,(B₁).dirBound 0 A)→‖leftDerivs U l 1-leftDerivs K l 1‖ ≤ (m1+m1)*c) ∧ ∀ p∈Local.tests F,‖iteratedDeriv p.2.val (K ∘ (hol G).testLinks d 0 (t0 • p.1)) 0‖≤ m1*c:=by
          subst Zδ; obtain ⟨hE,hO,hF,hx⟩:= hv e hc; refine mire hm hP hp hb hV hC H z I (Cors e hc) (R e) i rfl hE hh hO hF hx hL (fun Hr=>?_)
          have hz: (P.activities.reg i).support=b:=by rw [hy]
          rw [hz] at Hr ⊢; apply Peak.spoke _ _ (hol G) b h.smooth Hr (by have h:= Return.enough_room A.B (m+1) n; omega) ?_ (Nat.le_refl d); swap; · rw [show P.p=B₂ from (H.knows _ z.2).1.point]; exact ((hP'.trans hb.1.1).trans (hY.stage (m+1)).1)

          intro i; exact (h.proj Hr i).2
       obtain ⟨hA,hft,htY,ha,hV',ht'⟩:= heQ Complex.reCLM juror (show T'.live=Cors _ _ from rfl)
       obtain ⟨hB,-,hz₁,hβ,hU,hC⟩:= heQ Complex.imCLM jurorI (show T'.pale=Cors _ _ from rfl)
       have hw(p:Local.Probe G d)(hy:p∈Local.tests F): ‖Local.runProbe F p a‖ ≤ sprite G y L u'*m₀:=by
           have hR : (B₁).Regular X' (Blush.pane Z T' v0 (icon Z i)):= regular_smul v0 (regular_add (ornate hA) (regular_smul Complex.I (ornate hB)))
           rw [← Local.sample_eq F _ _ _ hR he.order]; apply (routeB p htY hz₁ ha hβ (hol G) hR he.order hft hV' hU (ht' p hy) (hC p hy) he.power).trans
           have hq:= mul_le_mul_of_nonneg_right (hZ.cycle p hy) (show 0 ≤ c/(coinP G L y) by have ha:0≤c:= (show 0≤c from (Cors Complex.reCLM juror|>.profit)); exact div_nonneg ha (coinP_pos G L y|>.le)); apply le_trans _ (mul_le_mul_of_nonneg_left (show c≤ m₀ from P.p.loMass _ _ (Cors Complex.reCLM juror|>.profit)) ((sprite_pos _ hu).le)); rw [show ‖v0‖=((L).val:ℝ)^d from by simp]; unfold m1 sprite; unfold chief at hq; linear_combination (norm:=ring_nf) hq; exact le_rfl
       have hp₁:= sprite_pos («L»:=D.L J) (G:=G) y hu; obtain ⟨ht',h0⟩:= (Local.probe_budget F).choose_spec.choose_spec
       apply (mul_le_mul_of_nonneg_left (add_le_add (h0 _ _ (mul_nonneg hp₁.le hmpos) hw) hCpool) (zero_le_one.trans h₃)).trans
       -- add calc manually
       apply le_trans _ (mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right hZ.reg (coinP_pos G L y|>.le)) hmpos); rw [show ‖v0‖=((L).val:ℝ)^d from by simp]; unfold Local.testPrice T0 x0 T1 m1 sprite; ring_nf; exact le_rfl
    have hE(e:ℂ→L[ℝ]ℝ)(hc:∀ i,‖e i‖ ≤ ‖i‖) {Zδ: Leaf P}(hf: Zδ=Cors e hc):
       let U:=matin Zδ Z (icon Z i) Chi.canonical; (B₁).Regular X' U∧ ∃ t:ℝ,(B₁).supBounds 0 X' U t ∧ t ≤ x0:=by
           subst Zδ; obtain ⟨hE,hO,hF,hx⟩:=hv e hc
           have ht:(P.p.mass (Cors e hc).crest (Cors e hc).weight)=m₀:=by change P.p.mass (P.activities.reg i).support c=m₀; rw [hy]
           rw [show x0=m1*P.p.mass (Cors e hc).crest (Cors e hc).weight from congr_arg (m1*·) ht.symm]; exact desert hm hP hp hb hV hC H z I (Cors e hc) (R e) i rfl hE (lt_of_not_ge hh) hO hF
    obtain ⟨hA,t,hf₀,hg⟩:= hE Complex.reCLM juror (show T'.live=Cors Complex.reCLM juror from rfl)
    obtain ⟨hQ,s,hf₁,hr⟩:= hE Complex.imCLM jurorI (show T'.pale=Cors Complex.imCLM jurorI from rfl)
    have hR:= regular_smul v0 (regular_add (ornate hA) (regular_smul Complex.I (ornate hQ)))
    have H' : (B₁).supBounds 0 X' (Blush.pane Z T' v0 (icon Z i)) (‖v0‖*(x0+x0)):=by
        have hp': (B₁).supBounds 0 X' _ (‖v0‖*(t+‖Complex.I‖ * s)):= bound_smul v0 (bound_add (ornate hA) (regular_smul Complex.I (ornate hQ)) (pricingG hA hf₀) (bound_smul _ (pricingG hQ hf₁)))
        rw[Complex.norm_I,one_mul] at hp'; have h₁ : ‖v0‖*(t+s) ≤ ‖v0‖*(x0+x0):=mul_le_mul_of_nonneg_left (add_le_add hg hr) (norm_nonneg _)
        exact ⟨hp'.1.trans h₁,fun i hi j hj HK=> (hp'.2 i hi j hj HK).trans h₁⟩
    apply (mul_le_mul_of_nonneg_left (add_le_add (Local.weighted_bound (hol G) F 0 hR he.order he.power H') hCpool) (zero_le_one.trans h₃)).trans; apply le_trans _ (mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right hZ.huge (coinP_pos G L y|>.le)) hmpos); rw [show ‖v0‖=((L).val:ℝ)^d from by simp]; unfold T0 x0 T1 m1 sprite; ring_nf; exact le_rfl
