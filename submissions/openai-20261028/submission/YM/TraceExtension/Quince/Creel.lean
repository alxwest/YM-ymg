lemma ribbonW {f : Config G cX→ℂ}{r k:ℝ}{a:(F).Coeff} (hX : Fancy tu H N n m (hol G) f S! M' a w! k r):
    let i:= enter WW (icon WW I); let Y:= (M').row 0 (S!) (hol G) (O).p.threshold
    (F).coeffSize ((∑' j,Y j)-a) ≤ (F).coeffSize (Y i-a)+r0*(‖vb‖*(marvel (Q:=Q') (x:=f₀) (L:=L₀) pT+marvel (Q:=Q') (x:=f₀) (L:=L₀) pT)):=by
    intro i f; let M0:= (M'); obtain ⟨a',b,c,tempρ,-⟩:= hX
    have hf: M0.Format 0 S! O:= tempρ.1
    have hS: (O).p=B:=by rw [he]; rfl
    have hp':= hC _ _ (A.B.valid.pays m) _ (step_paid A.B.a m)|>.1
    obtain ⟨p₁,b₂,y₀,gP,v₀,Y',g₁,C',g',e,uc,hB,hV,N'',hη⟩:= hp'.2 _ _ _ _ (Opera.protocol A.B hm R.pledging.conducts.full) _ _ WW
    have ho:= Rain.jersey (A:=A) (m:=m)
    have hS':0∈ pT.live.crest.image (S').ratio.parent:= support_zero _ _ hZ
    have hY': (B).supportExponent+2≤(R.expense j₀ i₀).earn:=by rw [ho.2.2.1]; have h:=R.pledging.agenda _ _ (step_paid A.B.a m)|>.1; linarith
    obtain ⟨hz',hq⟩:= Cub.brimmed WW pT 0 (pupil U x pT.live) (pupil U x pT.pale) vb F N'' hη hp'.1 hB rfl rfl ho.1 hY' (ho.2.1.symm ▸ hV) hS' hI (hol G) hS hf (livelyCard hp hd)
    unfold f; rw [hS]
    let Vα(j):= M0.row 0 S! (hol G) (B).threshold j; let Wβ(j:ℕ):=if j=i then (0:(F).Coeff) else Vα j; let K'(j:ℕ):=if j=i then Vα i else 0
    have hF: Vα=Wβ+K':=by funext j; by_cases hj:j=i <;> simp [hj,Vα,Wβ,K']
    have hx: HasSum K' (Vα i):=hasSum_ite_eq _ _
    have hv: Summable Wβ:=by
        have hw:Summable Vα:=hz'; have hy: Wβ= Vα-K':=by rw[hF]; abel
        rw [hy]; exact hw.sub hx.summable
    have hz : ∑' j,Vα j = Vα i+∑' j,Wβ j:=by nth_rw 1[hF]; rw [add_comm Wβ K']; exact (hx.add hv.hasSum).tsum_eq
    change (F).coeffSize ((∑' j,Vα j)-a) ≤ (F).coeffSize (Vα i-a)+r0* _; rw[hz, add_sub_right_comm]; exact (Extra.Histories.Size.add F _ _).trans (add_le_add_right hq _)
