-- reserve on precision **after** marginal distortion
def takePaid (X : Turns) : Till where
  floor := X.z/2
  expense := X.z/2
  floor_pos := half_pos X.carries
  expense_nn := (half_pos X.carries).le

-- published use for the calendar (eventual funds before any operations)

def Frisk (T : Tube G S) (x : ℝ) (q : Promise) (X : Turns) :=
    ∀ (A : Stores S) (V : Config G c) (F : Forest S.ratio), cert S x A V →
      Served q (gram T F x A V) (dcol S) ∧ X.Takes (eyes S G (radiusB x)) (gram T F x A V) (dcol S) (paceR x)



