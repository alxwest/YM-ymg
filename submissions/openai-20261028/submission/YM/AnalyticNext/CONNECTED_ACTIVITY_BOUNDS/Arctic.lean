variable {G : Gauge} {c f n : Side} {S : StepData c f} {T : Tube G S} {x : ℝ} {F : Forest S.ratio} {A : Stores S}

def snapCharge (Y : Mint T F A x) (b : Bond f) (β : ℝ) (z : ArrayR G f) :=
    ∑ i : G.ColorIndex, -β * power β * (Y.sheet *ᵥ Y.μ + Y.source) (b,i) * z (b,i)

def snapSale (Y : Mint T F A x) (b : Bond f) (β : ℝ) (z : ArrayR G f) := Real.exp (snapCharge Y b β z)-1

def televised (S : StepData c f) (x : ℝ) (i : Bond f) := den (home S i) 80 (radiusB x)







