include hT hC hR he


variable (hN : Choice N r) {b : Costs} (hf : FeeBook T x W r R N b)
include hf hN



omit hT hN hC hf hR he in
lemma photographs (s : Finset (Tab S)) (i) (y) (hv : shelves S A A' (surface S T R x s))
    (he : Agrees (surface S T R x s) V V') : Shed F (figure T x r B A F V i y) (figure T x r B A' F V' i y) (surface S T R x s) := by
  refine ⟨hv,he,fun j _ => rfl,fun j _=>rfl,fun j _=>rfl,?_⟩
  simp only [figure,and_self]







