     have hΞ:= Opera.protocol A.B hm R.pledging.conducts.full (n:=n); obtain ⟨A₀,ba,q,t',z,F'₀,t₃,t₄,t₅,t₆,k',hB,hX,N₀,hN'⟩:=hC.1.2 _ _ _ _ hΞ (Q x) _ (houseS H x) -- b' conflict
