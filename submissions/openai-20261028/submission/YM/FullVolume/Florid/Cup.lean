   obtain ⟨h0,h1,h2,h3⟩:= Rain.jersey (A:=A) (m:=m)
   let s:=(V₀).val; let d:=Q'
   have hh:= (weather H h hV he).2 V C hC
   let E:= R.expense K J; let a:= he K J (step_paid A.B.a m) _ (A.B.valid.pays m)
   obtain ⟨hz,hD⟩:= pocket H h (A.B.a.S.oneStep m n|>.exact_size) s (H.sight V₀) d p
   have hc:= setting H h
   have ht:= fun (i:Stars)=> academia H h Y i (d:=p)
   have hx: e ≥ Trio.tent r (radiusB Ω)+4:= by unfold Trio.base; omega
   have hv:=(hc.height)
   have Hq:( (raiser B).supportExponent+1)= (B).supportExponent+2:= (by change (B).supportExponent+1+1=_; ring)
   have hg(i:Site (A.B.a.S.side m n)):(coverNumber (B).B (neighbors (2*e) i):ℝ) ≤ Trio.coverTicket r:=by unfold Trio.coverTicket; apply Nat.cast_le.mpr; apply le_trans (Trio.scaleMeters r (radiusB Ω) (B).B_pos i _ le_rfl);rw [two_mul]
   have hk := Jams.funds (k:=p) Pz D' hx ht rfl hz hg hv; let y:=potP G L r Z Ω
   have hK: league (X').softer (B).B (fun t:sun=>(f' t).logarithm) ((B).supportExponent+2) (φ/4) y:=by
        rw [← Hq]; have ht: Marlin.tithe (2*e) (grail (Meadow.studio r (radiusB Ω)) (Rain.moor R.target A m) (fun _=>baseP G L r Z Ω) δ) B (Trio.coverTicket r)= y:= by unfold y potP Marlin.tithe; rw [h2]; rfl
        exact ht ▸ hk
   obtain ⟨k,hp⟩:= a.shiftT y (budget_nonneg (hK.choose_spec.1 0)) le_rfl
   have hw:= Crew.binning V C O hh (show 2≤φ from (by linarith))
   let Fk t x l:= Mallow.spice (f' t) (Crew.dawn V C Chi.canonical t x l)
