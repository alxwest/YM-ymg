lemma inflation (hp:1≤ v)(hP:Kit (fun i=> (W'.kernel i).support) v C' y P.B (P.supportExponent+1))(hh:league W'.softer P.B (Tap.logarithm ∘ x) (P.supportExponent+1) v b')(hr:Payments.Rates P.B s' C' b' κ) : Kit (fun i=> (addr (folio G c) P i).support) v s' (fun t ry u=> final.frigid W' (x t) (fun ry=> y t ry u) P ry) P.B P.supportExponent :=by
   let Zk:=drawer G c; let X t ry u:=widen W' (Mallow.spice (x t) (y t ry u)); apply seasons (f:=X) (V:=fun t=> widen W' (x t)) (folio G c) hp ?_ (flown P _ (upS W') (soft_up W') hh) hr (fun t x y=>rfl) -- order
   let U:=upK W'; obtain ⟨z,hz,hV⟩:= hP; refine ⟨stuff U z,fun i=>transfer_budget (upK W') ?_ ?_ (hz i),fun i=>?_⟩
   · intro j; change (if _∈ (Zk.kernel _).support then _ else _)=_; unfold Zk; rw [hard_up,stuffed]; dsimp only; rw [hard_up]; rfl
   · intro j hj; rw [blank _ _ hj]; simp
   by_cases he:i∈Set.range U; obtain ⟨j,rfl⟩:=he; rw [stuffed]; let z t ry v:= (X t ry v).forced; have hh t ry v: z t ry v (U j)= y t ry v j:= stuffed ..
   · unfold Sounding;change Strung (fun t u x py=> z t x py _ u) _ _; simp_rw [hh]; exact hV _
   unfold Sounding; have ht(t:sun) ry v:(X t ry v).forced i=0:= blank _ _ he; change Strung (fun t u x v=>(X t x v).forced i u) _ _; rw [blank _ _ he]; simp_rw [ht];exact Strung.none hp
