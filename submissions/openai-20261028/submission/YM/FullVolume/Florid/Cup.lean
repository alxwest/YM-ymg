   let w0:= F Jams.tip; let u:= w0.val.beta; have hb : u ∈ band A.B.a (m+1):= w0.property.2
   have hY := (Roof.coating H.earns.conducts H.paid (R:=fun _=>w0.val) (s:=Set.Icc (0:ℝ) 1) (fun _ _=> hb)).width
   have ht:= leg_on («X»:=E') («b»:=(A.B.a.params m).clip) g hy hH (by linarith) (A.B.support.cap N m H.paid.le) hY (decentA H h) κ (UVNext.CouplingReset.within_alpha («B»:=A.B) H.paid) hq
   rw [hx] at ht
   have ht: league (Rx).softer (B).B (fun t=>(T' t).logarithm) ((B).supportExponent+1) (q/2) (2*f):= ht
   have hh:=(hQ.emits K J (step_paid A.B.a m) Ω (A.B.valid.pays m)).1
   have hk :=parcel H h hV he V C hC
   obtain ⟨κ,hP⟩:= (he K J (step_paid A.B.a m) Ω (A.B.valid.pays m)).later B (hx ▸ ⟨rfl,rfl,rfl⟩) rfl rfl (budget_nonneg (ht.choose_spec.1 0)) -- hx orientation
   refine inflation (T') (shiftingK H hV V C) Rx (by linarith) ?_ ht hP
   have hp : (φ/4)≥q/2:=by linarith
   obtain ⟨x,hx,hZ⟩:=hk; exact ⟨_,hx, fun i=> (hZ i).bright (by linarith) hp⟩
