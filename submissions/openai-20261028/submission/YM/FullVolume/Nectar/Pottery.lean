lemma perfumeS (z:V→ℂ)(hl:f.val.val.val.Lawful σ ℓ s ε e)(U:Config G (A.B.a.S.side (m+1) n)):story (F1) z T₀ U=Poly.pass (Mach B z) * Expense ((Xk.colony p|>.hat f r)) w (Sx) U:=by
   rw [Xk.festival f p hw r hl]; let Vx:= Xk.hat f r; let hO:= heap Vx
   have hd(z): rush Vx z U=rush T₀ z U:=by
        unfold Menu.rush; apply sum_congr rfl; intro v _
        obtain ⟨hu₀,hv,ht,hx⟩ := hp v
        unfold WKey Menu.amount Menu.stamp;rw [hu₀,hv,ht,hx]
   have hb :Menu.roll Vx U=∑ i,odour (T₀ i) U:=by
        rw [← perfumes]; unfold Menu.roll; have hh : logDeck Vx=logDeck T₀:=by ext; rw [cams,cams]; apply exists_congr; intro i;rw [show WKey (Vx i)=WKey (T₀ i) from (hp i).1.symm]
        rw [hh]; exact sum_congr rfl (fun i _=>hd _)
   have hf(z):Accent.bar (F1).activities B U z+Menu.board (heap Vx) z U =Accent.bar (F1).activities B U z+∑ i,fragrance (T₀ i) U z:=by
        rw [← patron,banded]; apply congr_arg; unfold Menu.board; exact tsum_congr fun j=>hd _
   let s:=Mach B z; rw [show (Expense (Menu.heap (Xk.hat f r)) w Sx U) =(Real.exp ((F1).exponent U):ℂ) • (Menu.jets hO U* Accent.field (fun p=>Accent.bar (F1).activities B U p+board hO p U) _) from (passIn (heap Vx) Sx hl hw U)]
   unfold story play; rw [show hO=heap Vx from rfl, Menu.golden]; simp_rw [hf]; rw [← hb];
   have hW: (Menu.roll Vx U).part B.quiet=0:=by unfold Menu.roll;simp [Poly.part_sum,still Vx _ U];
   rw [Extra.Trajectories.pass_add (Accent.mute B z) hW, mul_smul_comm,mul_assoc]
include g h hs hX ha
lemma appliesF (hut: Offer o ((Xk.colony p|>.hat f r)) w (A.B.a.budget (m+1)).B ((A.B.a.budget (m+1)).supportExponent-4) a) (he:Palette.shipPrice Ls (R.target (A.B.a.clock.J (m+1)) (A.B.a.clock.J m)) (A.B.a.clock.hatBeta m) M a) (z:V→ℂ): let E:= PE H (Xk.colony p) w f r; let K:= PK H (Xk.colony p) w f r
    (∀ i,Burns ((A.B.a.clock.op m n).ratio.parent ∘ o) i (E i) ((A.B.a.budget m).threshold)) ∧
    (∀ i, Accent.Flow ((A.B.a.clock.op m n).ratio.parent ∘ o) i (K i) ((A.B.a.budget m).threshold)) ∧
    (A.B.a.clock.op m n).push f.val.val.val.beta (story f.val.val.val z T₀)=oven (H.moment (f.val.val)) z E K ∧
    (∀ i U,(K i U).part B.quiet=profile (H.moment f.val.val).activities (fun j=>Complex.ofReal ∘ (H.moment f.val.val).activities.K j) i U) ∧
    (∀ i U j,(K i U).part (B.fire j)=∑ l,owl (T₀ l) (portal H f.val.val) j i U):=by
    let W:=Xk.colony p; let T:= W.hat f r; intro E X
    have hx := assigns H g (Y₀) w o hs Θ hw h hX ha T hut he; have hv : Claims H (Y₀) w o T (portal H (Y₀)) E X:= hx
    let H0s:=H.sight (Y₀); let R0f:= f.val.val.val
    let hL := (Y₀).property.1.valid; refine ⟨hv.beams,hv.farm,?_,hv.mute,?_⟩
    · funext U; let u:= Mach B z
      rw [show story (F1) z T₀=fun U=> Poly.pass u*Expense T w (Sx) U from funext (perfumeS w p Xk f r T₀ hp hw z hL),Menu.convective _ _ _ (_: (Sx).IsKernel R0f.beta G) (Menu.heat T _ w hL)];
      · rw [hv.earns]; unfold oven play; let t:Poly B:=∑ i,E i U
        have hX : t.part B.quiet=0:=by unfold t; rw [Poly.part_sum]; exact sum_eq_zero (fun i _=> (hv.beams i).sil U)
        rw [Extra.Trajectories.pass_add (Accent.mute B z) hX,mul_smul_comm]; unfold u; rw [mul_assoc]
      exact (Sx).isKernel (funds_branch H0s.laws.intake.ready) _ -- missing.
    intro i U j; rw [hv.pops]; have he := Xk.owlSum H f p r (portal H (Y₀)) j i U; rw [show (∑ v,Menu.owl (T v) _ _ _ _)=_ from he]; refine sum_congr rfl (fun i' _=>?_); obtain ⟨ha,hx,he,hD⟩:=hp i'; let u:=portal H (Y₀)
    have hM:=charged u ((soundVisit H g _ hs h.hA).2) _ _ ha hx
    unfold Menu.owl quoted;rw [he,hD]; split_ifs; · change _* (profile _ _ i U) = _; exact congr_arg (fun f'=> (Xk.hat f r i').charge * profile ((H.moment (Y₀)).activities) (fun i=>Complex.ofReal ∘ f' i) i U) hM.symm
    exact rfl
