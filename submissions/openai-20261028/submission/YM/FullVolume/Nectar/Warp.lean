        _ = (Φ.liftT (φ/2)*(2*l*VhE))/2:= rounded ..
        _ ≤ β/2:= by exact div_le_div_of_nonneg_right hx zero_le_two
        _ ≤ β:= by linarith only [hm]
   have hv':= inv_mul_le_iff₀ (glyphpos _) |>.1 hv; rw [glyph_eq]; have hh:=mul_nonneg (Blush.glyphpos Ω).le hm; change l*Vh ≤ Blush.glyph Ω * β; rw [mul_assoc 2] at hv'; exact (show _ from (calc
    _ = (2*(l*Vh))/2:=by let x:=l*Vh; change x=(2*x)/2; ring
    _ ≤ (Blush.glyph Ω*β)/2:= by gcongr
    _ ≤ _:= by linarith only [hh]))
