   obtain ⟨hu,ht⟩:= hw K J (step_paid A.B.a m) 0 (Nat.zero_le _) _ (A.B.valid.pays m) _ (V₀).val P.pole
   have hc:0≤ wn:= scentL P.pole (U₀)|>.2.1; have he:n_cost≤1:=cutFee G D K J
   let β:= (V₁);have hm:0≤ β:= mul_nonneg (Real.exp_pos _).le P.pole.profit
   have hx:Φ.liftT (φ/2)*(2*l*VhE) ≤ β:=by
        apply le_trans (b:=n_cost*β) _ (mul_le_of_le_one_left hm he); unfold Nbudget; simpa only [pow_zero,mul_one] using! hu
   have hv:(Blush.glyph Ω)⁻¹*(2*l*Vh) ≤ β:=by apply le_trans (b:=n_cost*β) _ (mul_le_of_le_one_left hm he); unfold Nbudget; simpa only [pow_zero,mul_one] using! ht
   constructor
