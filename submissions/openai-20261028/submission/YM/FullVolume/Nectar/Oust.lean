lemma realities (F:I→ Menu.Hat B (flown Y x).val)(hF: Offer o F w (A.B.a.budget (m+1)).B ((A.B.a.budget (m+1)).supportExponent-4) a)(he:Palette.shipPrice Ls (R.target (A.B.a.clock.J (m+1)) (A.B.a.clock.J m)) (A.B.a.clock.hatBeta m) M a) :
   let Yf:=Cryst.flown Y x; let tM i:=(F i).M; let c i:= Menu.sing (F i) w; let u i:=sumFee (F i) w
   Claims H Yf w o F (portal H Yf) (memoE H Yf tM c u) (memoK H Yf tM c u):=by
    intro u ft c U'
    have hm:= H.paid; let Sx:= sandboxK Y x
    let Bp:=A.B.a.budget (m+1); have hf:u.val.p= Bp:=u.property.1.point
    let hA := h.hA; let y:= A.B.a.clock.hatBeta m; let hh:= step_paid A.B.a m; have hJ:= hA _ _ (A.B.valid.pays m) _ hh; let E:=(R.expense (A.B.a.clock.J (m+1)) (A.B.a.clock.J m))
    obtain ⟨A₀,b,y₁,fY,kp,Yxg₁,p',P',gP,v',z,hB,hU,N₀,hN'⟩:=hJ.1.2 _ _ _ _ (Opera.protocol A.B hm R.pledging.conducts.full) _ _ (houseS Y x)
    let B':=(A.B.a.budget m)
    have hY : B'.supportExponent+3≤ E.earn:= by rw [show B'.supportExponent= (A.B.a.params m).supportExponent from rfl, params_eq A.B.valid m]; exact R.pledging.agenda _ _ hh|>.1
    have ht: Offer o F w u.val.p.B (u.val.p.supportExponent-4) a:=by rw [hf]; exact hF
    have hT:Palette.Plot ft (houseS Y x) U':= Photo.bidding _ B w hw F o hJ.1.1 (by rw [(houseS Y x).laws.intake.sizes,(houseS Y x).laws.data.funds.length_eq]; exact hB.covers) (by change 4 ≤ (Q!).exp+_+_; linarith only [hY,h.support,E.worth,E.first,E.second,(Q!).usable,(Q!).pos]) (hf ▸ h.sB) ha ht hX he
    have hv := Many.usable g hm Y x ft U' N₀ hA hB hT; let fℓ:= memoE H u ft c U'
    let t₀:= pupilK Y x ft U'; let M₀:=Photo.chain (Y.result (x:ℝ)) t₀ B c
    obtain ⟨-,hX',-,hG,hF',hm',hp'⟩:= Photo.hue (houseS Y x) Chi.canonical (Y.result x.val) t₀ B o' w hw (sandboxK Y x) F (sounds g hm Y x hA) (fun i=>by intro j hj; obtain ⟨i',hi,hj⟩:= mem_image.mp hj; subst j; exact mem_image_of_mem _ (hF.sites _ (mem_image_of_mem _ hi))) hv hv.gas rfl B'.exponent_pos.le (fun i U j=> (by obtain ⟨v,h,_⟩:=hv.gas.bought; exact Many.live Y x ft U' i U (((h i).works U).choose_spec))) -- named order use check
    have hδ: H.moment u=Y.result x.val:=Cryst.regarded H Y x hP hx|>.1
    have hpQ: memoK H u ft c U'= M₀:=by unfold memoK; rw [hδ,show Cryst.brands H u ft U'= t₀ from funext fun t=>funext fun p=> Cryst.palette H Y x hP hx _ _ _ _]
    rw [hpQ]; refine ⟨hX',hG,?_,?_,?_⟩
    · rw [hδ]; exact hF'
    · intro i U; rw [hδ]; exact hm' i U
    intro i U j
    exact (hp' i U j).trans (sum_congr rfl fun j' _=> (winK H Y x hP hx (F j') j i U).symm)
