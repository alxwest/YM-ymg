lemma hearthR (F:Lotus.Leaf (flown Y x).val): (portal H (flown Y x)).hinge F=(sandboxK Y x).hinge F:= by
   let R:= Cryst.flown Y x; let f:= pupil Y x F; have hp: Cryst.tree H R F=f:=funext fun i=> Cryst.motto H Y x hP hx F i; exact congr_arg (fun f=> Mallow.tonic f) hp
lemma winK (k:Menu.Hat B (flown Y x).val)(i:V)(y:Box (A.B.a.S.side m n))(U:Config G (A.B.a.S.side m n)): Menu.owl k (portal H (flown Y x)) i y U=Menu.owl k (sandboxK Y x) i y U:=by
    unfold owl quoted
    -- simplify hinge integral
    simp_rw [hearthR H Y x hP hx k.M,show H.moment (flown Y x)=Y.result x.val from Cryst.regarded H Y x hP hx|>.1]
