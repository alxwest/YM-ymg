lemma palmsQ (x:sun)(i:(H.sight V₀).fragrances)(u:Config G (A.B.a.S.side m n)): CoinsE H hV P x i u= f_ x (Blush.enter C₁ i) u:=by
    let I:= C₁; let e0:=Blush.enter I
    let Ep:= vx x; let Hp:=Jams.recital (Jams.guitar H hV) x; let j:=Hp.furrow i
    have he : (vx x).bookFoot (.inr j)=Zh i:= herb H hV x i
    have ht: Watch H hV P y₀ (e0 i)= locus P.pole I y₀ i:=e0.injective.extend_apply ..
    have hQ:= Charity.mask_ag (P.flies x) Ep O j u (Pressure.temp Ω) y₀ -- t should temp! edit
    have hv:(v₀ x) (e0 i)= signalAt P O x i:= ((strains H hV P y₀ x _).2).trans (stuffed e0 _ i)
    unfold CoinsE;change masked _ (I.bookFoot (.inr i)) _ _= masked _ (Watch H hV P y₀ (e0 i)) _ _
    rw [ht,hv]; let Fk:= fun s=> masked (Pressure.temp Ω) s (matin (P.flies x) Ep j O) u; exact ((congr_arg Fk he.symm).trans hQ.symm).trans (congr_arg Fk (P.poleL x i y₀))
include h he hA hQ hw hZ hD hy
lemma facesH (hp:Daisy.poster Q L Ω ≤ 1) : RollsUp B Zh (fun t i u=> Complex.ofReal (CoinsE H hV P t i u)) (q/2) (B).supportExponent (Frets.tempo Φ L*V₁):=by
    obtain ⟨a,ha,hY⟩:= (tunedF H h hV hQ he hA P y₀ hy Φ hw hZ hD hp).funds
    let I:= C₁; let e0:= Blush.enter I; let Zi(i:I.fragrances):= if speaks P.pole I i then a (e0 i) else 0; have ht: 2≤q:= hQ.sphere.2.1
    have hh(i:I.fragrances) : Watch H hV P y₀ (e0 i)= locus P.pole I y₀ i:=e0.injective.extend_apply ..
    refine ⟨Zi,budget_mono (budget_pull e0 e0.injective ha) (fun i=> ?_) (fun i=>?_),fun i u=>?_⟩ -- macros Q notation change
    · unfold Zi; split; exact mul_nonneg (Real.exp_pos _).le (hY _ 1).nonneg
      rw [mul_zero]
    · dsimp only; unfold Zi; split
      next he=> rw [hh,locus,if_pos he]
      next=> rw [mul_zero]; exact ha.1 _
    unfold Zi; split
    next h=> simp_rw [palmsQ H hV P y₀]; exact hY _ _
    next h=>
    apply Scout.replace ((Scout.still (by linarith : 1≤ q/2) (0:ℂ)).enlarged (norm_zero.le)); intro t ht
    let x:= pinch t
    have hz: ¬ speaks (P.flies x) (vx x) ((Vt x).furrow i):=by intro he; exact h ((P.reached x i).2 he)
    have hh:=Daisy.Charity.quiet (P.flies x) (vx x) O ((Vt x).furrow i) hz
    change 0=Complex.ofReal (CoinsE H hV P x i u); unfold CoinsE
    rw [hh,masked]; simp
