abbrev tempo (Φ:Tableau q 300) (ℓ:Side):ℝ:= (Φ.price*(1+ (ℓ.val:ℝ))+1)*2
private lemma moments (s x:ℝ)(hq:0<s): ((1-s/2/s)⁻¹)*x=2*x:=by field_simp;ring
private lemma Dimes {c:Side}{Y':BudgetPoint}{t p':ℝ}(X:ℕ→Support c)(u:sun→ℕ→ Config G c→ℝ)(h₀:2≤q)(h:Bureau Y' X u q p' t): RollsUp Y' X (fun t i x=> Complex.ofReal (u t i x)) (q/2) p' (2*t):=by
     obtain ⟨a,ha,h⟩:=h.plan; refine ⟨(2:ℝ) • a,br_scale ha zero_le_two,fun i Q1=>?_⟩
     have hv:=((h i).2 Q1).beasts (by linarith : 1≤q/2) (by linarith : q/2 < q); rw [moments q _ (by linarith)] at hv
     exact Luna.goes_complex hv
private lemma dues (a b:ℝ): a*2*b=2*(a*b):=by ring
lemma jewelsR {G: Gauge} {c:Side} {v p' e' a b:ℝ} (T:Tableau q 300) (u1:sun→ℕ→ Config G c→ℝ) (U:BudgetPoint)(W':ℕ→Support c)(hq:2≤q)(hv:q≤v)(h:Bureau U W' u1 v p' a) (hn:∀ t, TicketC U W' (u1 t) p' (e'*b))(hp:T.liftT v * a≤b):
    RollsUp U W' (fun x i y=> Complex.ofReal (u1 x i y)) (q/2) p' ((T.price*e'+1)*2*b):=by
    have ht:= (h.tepee T hv hn).raise ((add_le_add_right hp (T.price*(e'*b))).trans_eq (show T.price*(e'*b)+b=(T.price*e'+1)*b by ring))
    rw [dues]; exact Dimes _ _ hq ht
