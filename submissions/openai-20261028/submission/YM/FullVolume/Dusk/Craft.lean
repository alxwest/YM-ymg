open MergeProof.Matric


abbrev issueE (H:Spring B N m n x t K)(z: Set.Icc x t)(Vi:RG.Rep G (A.B.a.S.side m n))(hs : HasSlots Vi.p Vi.activities) (T':Cloud (K z)) : MergeProof.Matric.Pin F n₀:= closeK (R0:=Vi) (Guard.Keeper.sufficient hs) (payR H z T' (d:=d) Vi (Guard.Keeper.sufficient hs))
def vote (H:Spring B N m n x t K)(z: Set.Icc x t)(Vi:RG.Rep G (A.B.a.S.side m n))(hs : HasSlots Vi.p Vi.activities)(hr: HasSlots (K z.val).p (K z.val).activities) (hb: Push.Local.Readable (hol G) (localSection G d) (K z).p (A.B.a.S.side (m+1) n) (Cub.title G (M.p.profile (A.B.a.clock.J (m+1))))) (i:(F).Index): Pin F n₀:= if i=0 then closeK (R0:=Vi) (Guard.Keeper.sufficient hs) (Extra.Histories.primary 0 (((L).val:ℂ)^d • (F).e0)) else issueE H z Vi hs (lark (K z) i hb hr)
private lemma seeking {G':Gauge}{n:Side}(B:BudgetPoint)(X_:Support n)(F_:Config G' n→ℂ)(h:∃ c,B.supBounds 0 X_ F_ c): B.supBounds 0 X_ F_ (sInf {y_| B.supBounds 0 X_ F_ y_}):= ⟨le_csInf h (fun i hi=> hi.1), fun i hi l hl ht=> le_csInf h (fun i' hf=> hf.2 i hi l hl ht)⟩
def paintG (H:Spring B N m n x t K)(z: Set.Icc x t)(Vi:RG.Rep G (A.B.a.S.side m n))(hs : HasSlots Vi.p Vi.activities)(hr: HasSlots (K z.val).p (K z.val).activities) (i:ℕ) (f:Config G (A.B.a.S.side (m+1) n)→ℂ):Pin F n₀:=
   if h: RegFit (K z) 0 d (hol G) (mapSeat i) f ∧ ∃ c,(K z).p.supBounds 0 (mapSeat i) f c then
       issueE H z Vi hs (float (K z) 0 (mapSeat i) (spot _ _) f _ h.1.smooth (seeking _ _ f h.2) hr)
   else 0
-- sector.B empty K also at qualified.`
private lemma dozing {ι:Type}[Nonempty ι](f:ι→ℂ)(h:∃ y_:ℝ,∀ V,‖f V‖≤y_)(V): ‖f V‖ ≤ sInf {y_|∀ V,‖f V‖≤y_}:= le_csInf h fun u_ hu=> hu V
def pickleP (H:Spring B N m n x t K)(z: Set.Icc x t)(Vi:RG.Rep G (A.B.a.S.side m n))(hs : HasSlots Vi.p Vi.activities) (i:ℕ)(f:Config G (A.B.a.S.side (m+1) n)→ℂ):Pin F n₀:= if h: SlotFit (K z) 0 i f∧ f ≠ 0 ∧ ∃ c:ℝ,∀ U,‖f U‖ ≤ c then issueE H z Vi hs (fan (K z) 0 i f _ (dozing f h.2.2) h.1) else 0
-- expose actual rows
abbrev placeQ (H:Spring B N m n x t K)(z: Set.Icc x t)(Vi:RG.Rep G (A.B.a.S.side m n))(hs : HasSlots Vi.p Vi.activities)(hr: HasSlots (K z.val).p (K z.val).activities) (hb:Push.Local.Readable (hol G) (localSection G d) (K z).p (A.B.a.S.side (m+1) n) (Cub.title G (M.p.profile (A.B.a.clock.J (m+1))))) : MergeProof.Matric.Plate F n₁ n₀:= ⟨Cub.vote H z Vi hs hr hb, paintG H z Vi hs hr, pickleP H z Vi hs⟩

lemma placedQ (hs: HasSlots ((A.B.bake.make meshT).rep N n m).p ((A.B.bake.make meshT).rep N n m).activities)
    (hr : HasSlots (K z).p (K z).activities)
    (h : Push.Local.Readable (hol G) (localSection G d) (K z).p (A.B.a.S.side (m+1) n) (Cub.title G (M.p.profile (A.B.a.clock.J (m+1))))) : shade H z hs hr h=placeQ H z ((A.B.bake.make meshT).rep N n m) hs hr h:=rfl
end YM.PhysicalNext.Repeat.Cub
