private lemma paidBound {G':Gauge}{n:Side}(Bg:BudgetPoint)(X_:Support n)(F_:Config G' n→ℂ)(h:∃ c,Bg.supBounds 0 X_ F_ c): Bg.supBounds 0 X_ F_ (sInf {y_| Bg.supBounds 0 X_ F_ y_}):= ⟨le_csInf h (fun i hi=> hi.1), fun i hi l hl ht=> le_csInf h (fun i' hf=> hf.2 i hi l hl ht)⟩
private lemma priceUp {G':Gauge}{n:Side}{u:ℝ}(Bg:BudgetPoint)(X_:Support n)(F_:Config G' n→ℂ)(h:Bg.supBounds 0 X_ F_ u): sInf {y_| Bg.supBounds 0 X_ F_ y_} ≤ u := csInf_le ⟨0,fun i (hi:Bg.supBounds 0 X_ F_ i)=> hi.1⟩ h
private lemma dozing {ι:Type}[Nonempty ι](f:ι→ℂ)(h:∃ y_:ℝ,∀ V,‖f V‖≤y_)(V): ‖f V‖ ≤ sInf {y_|∀ V,‖f V‖≤y_}:= le_csInf h fun u_ hu=> hu V
