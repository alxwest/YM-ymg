def inkMoney (T:U₁)(d:ℕ): Response G S₀ := if h: SlotFit z.val 0 i T ∧ T≠0 ∧ ∃ c:ℝ,∀ U,‖T U‖ ≤ c then moi H z (fan z.val 0 i T _ (dozing _ h.2.2) h.1) d else 0
lemma fitting {x:ℝ} (T:U₁)(d:ℕ)(hr:RegFit z.val 0 d (hol G) (mapSeat i) T)(h:z.val.p.supBounds 0 (mapSeat i) T x): let u:=sInf {y|z.val.p.supBounds 0 (mapSeat i) T y}; ∃ hf: z.val.p.supBounds 0 (mapSeat i) T u,
   spices H g z hz i T d=mei H g z (Blush.float z.val 0 (mapSeat i) (spot _ _) T u hr.smooth hf hz) d∧ regMoney H z hz i T d=moi H z (Blush.float z.val 0 (mapSeat i) (spot _ _) T u hr.smooth hf hz) d ∧ u≤x:=by
   unfold spices regMoney; intro u; rw [dif_pos ⟨hr,x,h⟩, dif_pos ⟨hr,x,h⟩ ]; exact ⟨paidBound _ _ _ ⟨x,h⟩,rfl,rfl,priceUp _ _ _ h⟩
lemma fitted {x:ℝ}(T:U₁)(d:ℕ)(hr:SlotFit z.val 0 i T)(Hs:T≠0)(h:∀ U, ‖T U‖ ≤ x): let u:=sInf {y|∀ V,‖T V‖ ≤ y}; ∃ hf:∀ U, ‖T U‖ ≤ u,
   spicy H g z i T d=mei H g z (fan z.val 0 i T u hf hr) d ∧ inkMoney H z i T d=moi H z (fan z.val 0 i T u hf hr) d ∧ u≤x:=by
   intro u; unfold spicy inkMoney; rw [dif_pos ⟨hr,Hs,x,h⟩, dif_pos ⟨hr,Hs,x,h⟩ ]; exact ⟨dozing T ⟨x,h⟩,rfl,rfl,csInf_le ⟨0,fun i h=>le_trans (norm_nonneg _) (h 1)⟩ h⟩
