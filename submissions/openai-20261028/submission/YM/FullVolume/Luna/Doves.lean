   have hg : P.pole.crest=Mt.pole.crest:=by rw [← Mill.crests _ tip, ←Mill.crests _ tip,← hS,← hh]; exact (T tip).turnout
   have hT(i:sun): (A₀ i).forced= u • nectar (Cryst.tree H (T0 i) (P.flies i))+(u*Complex.I) • nectar (Cryst.tree H (T0 i) (Mt.flies i)):=by rw [← hS, ← hh];change _ • (_+_ • _)=_; rw [smul_add,mul_smul]
   have hx:= gusts H h hV hQ he g hA P y₀ hy u; have hy':= gusts H h hV hQ he g hA Mt y₀ (hg ▸ hy) (u*Complex.I); rw [norm_mul, Complex.norm_I,mul_one, ← (scents H hV P y₀ Mt hS hh).2] at hy'
   rw [show 2*‖u‖*l*Vh=‖u‖*(l*Vh)+‖u‖*(l*Vh) by ring,show (fun i=>_)=(fun i=>_) from funext hT];exact addsUp hx hy'
