lemma scents : Watch H hV P y₀= Watch H hV Mt y₀ ∧ Nbudget H hV P= Nbudget H hV Mt:=by
   have ht : P.flies tip=(T tip).live:=(hS tip).symm; have hd : Mt.flies tip=(T tip).pale:=(hh tip).symm
   have hC:P.pole.crest=Mt.pole.crest:=by rw [← Mill.crests _ tip,← Mill.crests _ tip,ht,hd]; exact (T tip).turnout
   have h:P.pole.turn=Mt.pole.turn:=by rw [← Mill.kind _ tip, ←Mill.kind _ tip, ht,hd]; exact (T tip).together
   refine ⟨?_,?_⟩
   · ext i; unfold Watch billK Daisy.Charity.locus Daisy.Charity.speaks;rw [h]
   unfold Nbudget jewelDebt; rw [hC,← P.prices tip,← Mt.prices tip,ht,hd,(T tip).rates]
