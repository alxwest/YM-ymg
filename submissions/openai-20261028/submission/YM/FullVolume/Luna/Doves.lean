lemma bunch : Wires B y₀ (Watch H hV P y₀) (fun t=>(A₀ t).bulk) (φ/2) ((Υ).supportExponent+2) (2*‖u‖*l*VhE):=by
   have hg : P.pole.crest=Mt.pole.crest:= ((P.crests tip).symm).trans ((congr_arg _ (hS tip).symm).trans ((T tip|>.turnout).trans ((congr_arg _ (hh tip)).trans (Mt.crests tip))))
   let z t i:=u • (Complex.ofReal ∘ Cryst.clocks H (T0 t) (P.flies t) i); let k(t:sun) i:= (u*Complex.I) • (Complex.ofReal ∘ Cryst.clocks H (T0 t) (Mt.flies t) i)
   obtain ⟨⟨b,hb,hV0,hbp⟩,hE⟩:= priceW H h hV he hA P y₀ hy u
   obtain ⟨hc,hD⟩:= scents H hV P y₀ Mt hS hh
   obtain ⟨⟨d,hℓ,ha,hL⟩,hd'⟩:= priceW H h hV he hA Mt y₀ (hg ▸ hy) (u*Complex.I); rw [← hc] at hℓ hL hd'; rw [← hD,norm_mul, Complex.norm_I,mul_one] at hℓ
   have hz(s:sun)(i:ℕ) : (A₀ s).bulk i=z s i+k s i:=by
       let e0:= Blush.enter (H.sight (T0 s)); let u0:=u
       unfold z k Cryst.clocks; rw [← hS,← hh];change Progress.DirectedRecipe.stuff e0 _ i= _
       by_cases he:i∈Set.range e0; obtain ⟨i,rfl⟩:=he;rw [stuffed]; change _= u • (_ ∘ Progress.DirectedRecipe.stuff e0 _ (e0 i))+ _ • (_ ∘ Progress.DirectedRecipe.stuff e0 _ (e0 i)); rw [stuffed,stuffed]; unfold Blush.pane; rw [smul_add,mul_smul]
       rw [Progress.DirectedRecipe.blank _ _ he,Progress.DirectedRecipe.blank _ _ he,Progress.DirectedRecipe.blank _ _ he]; funext i; simp only [Pi.zero_apply,Pi.smul_apply,Pi.add_apply,Function.comp_apply,Complex.ofReal_zero,smul_zero,add_zero]
   have hy: Brill B (Watch H hV P y₀) (b+d) ((Υ).supportExponent+2) (2*‖u‖*l*VhE):=by
       rw [show 2*‖u‖*l*VhE=‖u‖*(l*VhE)+‖u‖*(l*VhE) from by ring]; exact br_add hb hℓ
   refine ⟨b+d,hy,fun i=> add_nonneg (hV0 _) (ha _),fun i w η hp=> ?_⟩
   rw [show (fun t=>(A₀ t).bulk i)=_ from (show _=fun t=>z t i+k t i from funext fun i=>hz _ _),mix_plus,Pi.add_apply,mul_add]; exact Next.Foundations.bound_add (paneR _ (fun s=>hE s i)) (paneR _ (fun t=> hd' t i)) (hbp _ _ _ hp) (hL _ _ _ hp)
