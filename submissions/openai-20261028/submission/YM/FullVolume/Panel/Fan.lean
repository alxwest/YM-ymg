    rw [Blush.scope] at hv; have hp i: Blush.scope Z (T' i) 0 = Blush.scope Z u 0:= hs i
    rw [(Blush.enter _).injective.extend_apply] at hv -- def L
    let y:=locus u.live Z 0 k
    have hg : Healthy (Pressure.temp (A.B.a.clock.hatBeta m)) (locus u.pale Z 0 k) V:= (arches Z u 0 k) ▸ hv
    have hh(M:Cloud (K z)):L M (s k) = Blush.pane Z M p k:= stuffed ..
    filter_upwards [Charity.catalog u.live Z N' hM k V 0 hv, Charity.catalog u.pale Z N' hM' k V 0 hg] with y hH hP
    let Y:=increment V y; change L u (s k) Y= (∑ i,(a i:ℂ) • (L (T' i) (s k))) Y
    rw [hh]; change p*((matin u.live Z k ψ Y:ℂ)+Complex.I*(matin u.pale Z k ψ Y:ℂ))= _; rw [show matin u.live Z k ψ Y= _ from hH, show matin u.pale Z k ψ Y=_ from hP]; simp_rw [Function.comp_apply,Finset.sum_apply, Pi.smul_apply,smul_eq_mul,hh];push_cast; simp_rw [Finset.mul_sum,← Finset.sum_add_distrib, Finset.mul_sum]; apply Finset.sum_congr rfl; intro i _; unfold Blush.pane; change _ = _ * (p*((matin (T' i).live Z k ψ (increment V y):ℂ)+Complex.I*(matin (T' i).pale Z k ψ (increment V y):ℂ))); ring
