    exact (added (f:=fun j=>waist H (F a) b hd T K i x j y U) hx.hasSum hq.hasSum).tsum_eq -- waist parameter is H Z b hd T K etc.
include hF
lemma portionC (y:Coin ST (hol G) T)(u:sun) : CE u (x-y)= CE u x-CE u y:=by
    have hx (x: Coin ST (hol G) T):=packR H g b hd U0 hU T ht K hk i x Θ F hP hc hp hG hS hℓ hJ Xf G₁ hW hf u; funext j U'; let P0s:=F u; obtain ⟨c,p,hZ⟩:=minted ST o_ T K i x; obtain ⟨c',p',hZ'⟩:= minted ST o_ T K i y
    let a(a:Coin ST o_ T)(s:ℕ):= regMoney H (F u).val (F u).property s (packY ST o_ T K i a|>.regular s) d j U'; let b'(a: Coin ST o_ T)(s:ℕ):= inkMoney H (F u).val s ((packY ST o_ T K i a).forced s) d j U'
    have ha(s:ℕ):a (x-y) s=a x s-a y s:=by
        obtain ⟨h₁,h₂⟩:= ReadyE g P0s b hd T ht K hk i x hZ s; obtain ⟨h3,h4⟩:= ReadyE g P0s b hd T ht K hk i y hZ' s; unfold a; rw [(solvent ST o_ T K i x y).1]; exact congr_fun (congr_fun (coolE H g _ b hd (hF u) s h₁ h₂ h3 h4) j) U'
    have hb(s:ℕ):b' (x-y) s=b' x s-b' y s:=by
        have h₁:= ReadyK g P0s b hd T ht K hk i x hZ s; have h₂:= ReadyK g P0s b hd T ht K hk i y hZ' s; unfold b'; rw [(solvent ST o_ T K i x y).2]; exact congr_fun (congr_fun (coolK H g _ b hd (hF u) s h₁ h₂ (hZ.stock s|>.2) (hZ'.stock s|>.2)) j) U'
    change ((∑' s,a (x-y) s)+(∑' s,b' (x-y) s))=((∑' s,a x s)+(∑' s,b' x s))-((∑' s,a y s)+(∑' s,b' y s))
    have hS(u): Summable (a u) ∧ Summable (b' u):=(hx u).2 j U'
    simp_rw [ha,hb]; rw [Summable.tsum_sub (hS x|>.1) (hS y|>.1),Summable.tsum_sub (hS x|>.2) (hS y|>.2)]; abel
variable {a:ℝ}(u:sun→ Coin ((Labels.frames G).level d) (Next.Foundations.hol G) T)(hu:PaidBeam (fun i:sun=> ((u i):Completion (Coin ((Labels.frames G).level d) (Next.Foundations.hol G) T))) a)
include hB hR he hu
lemma scopeC : Treasure Wc_ (fun s:sun=> CE s (u s)) (4*(2*(Θ.price+1)*(ρ*a))):=by
    let S:= Coin ST o_ T; let Y:=Completion S; let Z(s:sun)(x:S):= haul Wc_ (CE s x); let bC:=4*(C!*ρ); have hZ:0 ≤ bC:=by unfold bC; have h:=Θ.sane; have hh:=Doors.rate_pos L_; positivity
    obtain ⟨p,hψ,hU'⟩:=hu.arrives; let B:= Completion.toComplL (𝕜:=ℝ) (E:=S); have heB:Isometry B:= Completion.coe_isometry; have hv:=show DenseRange B from Completion.denseRange_coe
    have hm (t:sun)(x y:S): Z t (x-y)=Z t x-Z t y:=by
       have hL:= portionC H g b hd U0 hU T ht K hk i x Θ F hP hc hp hG hS hℓ hJ Xf G₁ hW hf hF y t; have hu (x:S):=(packR H g b hd U0 hU T ht K hk i x Θ F hP hc hp hG hS hℓ hJ Xf G₁ hW hf t).1; unfold Z; rw [hL]; exact Treasure.hoisted (hu x) (hu y) (hL ▸ hu (x-y))
    have hμ(x:S):PaidBeam (fun i=>Z i x) (bC*‖x‖):=by
        have hv:= Veil.anima H Xf hp (fun p:Ticket A N m n=> haul Wc_ (dossier H T K i p x)) (fun f hF=> (rays H g b hd U0 hU T ht K hk i x Θ f hP hc hp hG hS hℓ hJ hF).2.1) F G₁ hW hB hf Q hR he; exact (show PaidBeam (fun i=>Z i x) _ from ⟨hv⟩).larger (le_of_eq (by unfold bC; ring))
    obtain ⟨Q',ht',h⟩:= Beam.listen B heB hv Z hm hZ (fun x:S=> (hμ x).arrives) p u hU'
    refine Treasure.pay (fun _=>Real.exp_pos _) (PaidBeam.mk ⟨Q',ht'.trans ((mul_le_mul_of_nonneg_left hψ hZ).trans_eq ?_), h⟩) (fun t=>(packR H g b hd U0 hU T ht K hk i (u t) Θ F hP hc hp hG hS hℓ hJ Xf G₁ hW hf t).1)
    unfold bC; ring
lemma fundsT : Treasure Wc_ (fun t:sun=> loftyC H b hd T K i (u t) (F t)) (4*(C! * a_)+4*(C!*(ρ*a))):=by
   let A' t:= loftyC H b hd T K i (u t) (F t); change Treasure _ A' _; rw [show A'=fun t:sun=> E_ t+ CE t (u t) from funext (fun i'=>?_)]
   · exact (scopeE H g b hd U0 hU i Θ F hP hc hp hG hS hℓ hJ Xf Q G₁ hW hB hf hR he).addsP (scopeC H g b hd U0 hU T ht K hk i Θ F hP hc hp hG hS hℓ hJ Xf Q G₁ hW hB hf hR he hF u hu)
   exact prepC H g b hd U0 hU T ht K hk i _ Θ F hP hc hp hG hS hℓ hJ Xf G₁ hW hf _
end
