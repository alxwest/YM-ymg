lemma crowning : ∃ Ψ:Ray.sun→ Response G (R.alloy.B.a.S.side N p), Treasure (Pc) Ψ (Hk*(Ω!*(un)))∧ ∀ s:Ray.sun, K₀ t s N y = hook (R0_ s).activities (Z_).threshold (Ψ s) ∧ ∃ a,Attainment (R.alloy.B.a.budget N) y (Ψ s) a:=by
    let Q(t:Ray.sun):Rep G hn:= R0_ t; let f(s:Ray.sun):Response G (R.alloy.B.a.S.side N p):= booster X_ (Q s) 0 (V0 s); let m:= mintT T d N; let v(s:Ray.sun):= upwards t y (f s); let Z:= Q Jams.tip
    have hx(s):= imprint T W d N p F x hN₁ s; have h:PaidBeam (V0) (un):= (Face.incomePhase T W (Prestige.mk ⟨Θ,hk,he0,hP⟩) d N p N ha F hF x hz hN₁.le le_rfl|>.1).stamp (fun i=> (hx i|>.1).symm)
    have hY :∀ s,Z.p=(Q s).p:=fun s=>(year T W d N p F hN₁ tip).trans (year T W d N p F hN₁ s).symm
    have hv(s:Ray.sun): f s=booster X_ Z 0 (V0 s):=by
       unfold f booster; refine congr_arg (fun u:Config G hn→ℂ=> (Pi.single ((X_).footprint (0:Site hn)) u:Support hn→ Config G hn→ℂ)) ?_; funext v; simp_rw [supplement,Extra.Histories.part,hY s]
    have ht:= sound G d; have hZ : ∀ s,(Q s).p=Z_ :=year T W d N p F hN₁
    have hc : coverNumber Z.p.B ((X_).footprint (0:Site hn)) ≤ 1:=by unfold Z;rw [hZ]; exact crowner T W d N p F hN₁
    have hP: Treasure Pc f (Ω!*(un)):=by
       rw [← show Z.p=Z_ from hZ tip,show f= (fun s:Ray.sun=>booster X_ (Z:Rep G hn) 0 (V0 s)) from funext hv] -- replace
       exact dawnBoost X_ Z ht 0 (Doors.cameras_ge G d) (fun i U=> Doors.cameras_holds G d _ i 0 U) hc _ h
    refine ⟨m • v,Treasure.coal (Treasure.spin (P:=Z_) hP t y) (PaidBeam.static m),fun i=>?_⟩
    obtain ⟨E⟩:=(B₀ i|>.choice.represents N p N le_rfl|>.good.labels.moves t.1 y); have hx':= FullVolume.Nectar.fuseP X_ Z ht 0 (Doors.cameras_ge G d) (fun i U=> Doors.cameras_holds G d _ i 0 U) hc (V0 i)
    constructor
    · let p':= Q i; let x'(s:Ray.sun): Coefficient (Fy) (R.alloy.B.a.S.side N p):=(Fp s); change m • floatUp t y (profile p'.activities (x' i).forced)=hook p'.activities _ (m • upwards t y (f i)); rw [show profile p'.activities (x' i).forced = _ from (show profile p'.activities (x' i).forced= hook p'.activities (p'.p.threshold) (f i) from (hx i).2),← show p'.p=(Z_) from hZ i,hook_scale]; exact congr_arg (m • ·) (hooked t y (R:=p') E _ _).symm
    have Hs:=MergeProof.rise t y hx'; have hv' : Lattice.affine t.1 y 0=y:=by simp [Lattice.affine]
    change ∃ a,Attainment _ y (m • upwards t y (f i)) a; rw [← show Z.p= Z_ from hZ tip,hv]; exact ⟨_, stack_of (hv' ▸ Hs) m⟩
