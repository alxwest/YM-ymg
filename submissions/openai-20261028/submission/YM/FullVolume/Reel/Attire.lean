def noteS {G:Gauge}{v:Side}(i:Wing)(f:Config G v→ℂ): Essence G v:= fun j=> if i=j then f else 0
abbrev coinX (i:Wing)(v: Config G s₁→ℂ):= noteS i v
def dig (v:Lotus.Leaf R_): Config G s₁→ℂ:=Complex.ofReal ∘ v.ingredient
lemma moonDeck (he:p.live.turn∈S) (h:Graces.Effort (p_) (O_) o_ (Blush.scope (H.sight Z.val) p 0) (Luna.plot H Z.val ℓ F_ p) y va κ a s): let V:= Matric.tell (mei H g Z.val p d)
    Fleet R_ O_ (Orchard.portal H Z.val) S 0 0 ℓ 0 (prose p.live + Complex.I • prose p.pale) (entry p.live +Complex.I • entry p.pale) (profile (O_).activities V.forced) (2*load p.live) s (noteS p.live.turn (dig Z p.live +Complex.I • dig Z p.pale)) (moi H Z.val p d) :=by
    intro V; let T:= p; let D0s:=Orchard.portal H Z.val; have hs:= (Orchard.soundVisit H g _ hx hA).1
    let J:Bool→ Leaf (R_):= fun i=> if i then p.live else p.pale; let f(i:Bool):ℂ:= if i then 1 else Complex.I
    let Vx(i:Bool) j U:= ℓ*f i*((D0s.hinge (J i) j U):ℂ)
    let M:= plot H Z.val ℓ F_ p; let k:= (O_).activities
    have ht : M.forced=fun i U=> ∑' j:Bool,Vx j i U:=by
       funext i U; have he': M.forced= ℓ • ((fun i=> Complex.ofReal ∘ D0s.hinge p.live i) + Complex.I • (fun i=> Complex.ofReal ∘ D0s.hinge p.pale i)):= rfl
       rw [he']; simp [Pi.smul_apply,Vx,f,J,tsum_fintype]; ring
    have hv: SumBudget (fun i=> ‖ℓ*f i‖*load (J i)) (∑ i, ‖ℓ*f i‖*load (J i)):=⟨fun i=> mul_nonneg (norm_nonneg _) ((Leaf.profit _).trans ((R_).p.loMass _ _ (Leaf.profit _))),Summable.of_finite,(tsum_fintype _).le⟩
    have hm : Dominated (fun i:Bool×ℕ=> Vx i.1 i.2):= supplyLine _ hs (s:=fun i=>ℓ * f i) (M:=J) hv
    have hs':= EffortMint H g Z b hd p y h
    refine ⟨Bool,inferInstance,J,f, ⟨fun i=>?_,⟨fun i=>mul_nonneg (norm_nonneg _) ((Leaf.profit _).trans ((R_).p.loMass _ _ (Leaf.profit _))),Summable.of_finite,?_⟩, hs'.2.2.1,fun U=>?_,fun i U=>?_,fun i U=>?_⟩,?_⟩
    · cases i; exact ⟨T.turnout ▸ ho,T.together ▸ he⟩; exact ⟨ho,he⟩
    · rw [tsum_fintype,Fintype.sum_bool]; change ‖(1:ℂ)‖*load p.live+ ‖Complex.I‖*load p.pale≤ _; rw [norm_one,Complex.norm_I,two_mul]; have he:load p.live=load p.pale:=by unfold load; rw [p.turnout,p.rates]
      rw [he,one_mul]
    · simpa only [f,J,sub_zero,Pi.add_apply,Pi.smul_apply,Fintype.sum_bool, Bool.false_eq_true,if_false,if_true,one_mul,smul_eq_mul] using! hasSum_fintype (fun i=> f i*prose (J i) U)
    · simpa only [f,J,Pi.add_apply,Pi.smul_apply,Fintype.sum_bool, Bool.false_eq_true,if_false,if_true,one_mul,smul_eq_mul] using! hasSum_fintype (fun j=> f j*entry (J j) i U)
    · have he := hs'.2.2.2
      let ψ:= moi H Z.val p d; rw [show profile (O_).activities V.forced=profile (O_).activities M.forced+hook (O_).activities (O_).p.threshold ψ from he, Pi.add_apply,Pi.add_apply]; change HasSum _ ((_+ hook _ _ ψ _ _)-hook _ _ ψ _ _); rw [add_sub_cancel_right,ht]; exact (profile_shop k (f:=Vx) hm i U).congr_fun (fun j=>by unfold Vx profile cram; rw [tsum_mul_left];rfl)
    intro i U; have h:= hasSum_fintype (deposit f J U i); rw [Fintype.sum_bool] at h; by_cases hx:p.live.turn=i
    · rw [show noteS _ _ _= _ from if_pos hx]; simp only [f,J,deposit, if_true,Bool.false_eq_true,if_false,if_pos hx, if_pos (p.together.symm.trans hx),one_mul] at h; exact h
    rw [show noteS _ _ i=0 from if_neg hx]; simp only [f,J,deposit, if_true,Bool.false_eq_true,if_false,if_neg hx, if_neg (mt (fun h:p.pale.turn=i=>p.together.trans h) hx),zero_add] at h; exact h
