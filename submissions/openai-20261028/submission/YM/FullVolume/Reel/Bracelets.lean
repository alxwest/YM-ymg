       intro r E α u'; let W:= T₀ s; let Wp:= W.castT b (hX s) hd; let f:= F s; have hxP:f.val= Vot W:= hy s
       have hf': f.val.val.val= W.player:=congr_arg (fun i=> (i:Ticket A N m n).val.val) hxP
