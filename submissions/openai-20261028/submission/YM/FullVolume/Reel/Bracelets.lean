       have he(i:Motion):∃ p':W.player.activities.Moves i.1 ((VA).embed 0), travelW (R:=W.player) i ((VA).embed 0) p'=v i:=by
           rw [← hf']; exact ⟨alongM f _ _,(uniformM p i ((VA).embed _) f).symm⟩
       obtain ⟨a,b0,hF⟩:= originsP H g b hd U0 hU U hx K hk W (hX s) (hV s) (hm s) (V s) (X₀ s) (Q s) (hq s) (hf s) hJ v he (hz s) (hl s) (hi s) (x s) -- order
       let y:=(Vs s).x; let w:= (songs p U K Q z s); let A₀:= sprays (H:=A.B.bake.make (H₁ s)) (m:=m) (p:=n) (fun i=>slides U K i ((Q s).scythe i)) v
       let p'(x:Ticket A N m n):=flutes (H:=A.B.bake.make (H₁ s)) (m:=m) (p:=n) (fun i=> loftyC H b hd U K i ((Q s).scythe i) x) (z s)
       have hX : songsK H b hd U K F Q z s=p' (Vot W):=(show p' f.val=p' _ from congr_arg _ hxP)
       refine ⟨a,b0,?_⟩; rw [hX]; change Fleet f.val.val.val (H.moment f.val.val) (Orchard.portal H f.val.val) C0 _ _ _ _ (u'.exponentialEntry 0 p_ f.val.val.val) (profile f.val.val.val.activities u'.forced) (profile (H.moment f.val.val).activities α.forced) _ _ _ _  -- use explicit.
