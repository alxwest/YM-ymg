lemma relocated (hr:scalar Y v'=v') : Center H F Q o (fun i=> stepUp Y ((A.B.a.clock.op m n).ratio.embed o) (U i)) (fun i=> floatUp Y ((A.B.a.clock.op m n).ratio.embed o) (I₁ i)) (fun i=> floatUp Y o (I i)) (fun s=> scalar Y (τ s)) v' p (fun s=> dials Y v1 (guilder p Y v1) (x s)) (fun s=> upwards Y o (Ψ s)) vE vK vU:=by
    let P: (t:Booker A N m n T) → t.val.val.val.activities.Moves Y.1 v1:=fun i=>alongM i Y v1; let W:=guilder p Y v1; have he(t):travelW (R:=t.val.val.val) Y v1 (P t)=W:=(uniformM p Y v1 t).symm
    have ht(t): Q= Wing.labelRoute (P t) '' S:=by rw [hp,uniformM p _ _ t]; rfl -- binder annotation may fail
    have hv: (Φ).embed 0=0:= Motion.embed_origin _
    refine ⟨fun s=> ?_, Treasure.turning (R:=p.val.val.val) x Y v1 (P p) hp h.prices,(Treasure.spin (P:=Q0) h.stocks Y o), ((PaidBeam.transit (LensC Y) (map_sub _) zero_le_one (fun x=>by rw [one_mul];exact lensN Y x) _ h.spark).stamp (fun i=> (lens Y _).symm)).larger (by rw [one_mul]),fun i t=>?_⟩
    · intro R T; obtain ⟨a,b,hP⟩:=h.born s
      have hx:= hP.mobile Y o ((soundVisit H g _ (hF s) hA).1) (P (F s)) hr
      rw [show travelW (R:=(F s).val.val.val) Y v1 (P (F s))=_ from he _,← ht (F s)] at hx; rw [hv] at hx; simp_rw [Lattice.affine,Signed.act_zero,zero_add] at hx; exact ⟨_,_,hx⟩
    obtain ⟨j,hj,hy⟩:= (show i.val∈ Wing.labelRoute (P t) '' S from ht t ▸ i.property); obtain ⟨hp,hV⟩:=h.earns ⟨j,hj⟩ t
    have hc: 0∈ j.support t.val.val.val:= hv ▸ hV;
    rw [←hy]; refine ⟨Wing.fuelRoute (P t) j hp,?_⟩
    rw [Wing.supRoute (P t)]; exact Finset.mem_image.mpr ⟨0,hc, by simp [Lattice.affine]⟩
