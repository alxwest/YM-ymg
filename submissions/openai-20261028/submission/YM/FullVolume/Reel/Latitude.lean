    · intro i R E; obtain ⟨a,b,H⟩:=hC.born i; exact ⟨_,_,H.altoP ht⟩
    · exact Treasure.coal hC.prices (PaidBeam.static lam)
    · exact Treasure.coal hC.stocks (PaidBeam.static σ)
    · exact PaidBeam.transit (fun x:ℂ=>lam*x) (mul_sub lam) (norm_nonneg lam) (fun x=> (norm_mul ..).le) _ hC.spark -- mul_sub lambda
    exact hC.earns
