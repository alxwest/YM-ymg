import YM.Bid.Phase

/-!
# Norm separability of the compression algebra

Use Theme to work with canonical `M` rather than all slab widths (they give
these same operators). Only need to vary positions continuously for *basis*
label families, expanding in the caps by multilinearity. No separability
needed of the ambient operator space.
-/
set_option autoImplicit false
noncomputable section
namespace YM.Work.B12
open Set Function TopologicalSpace OS OS.Ground Word Bid
open scoped Topology NNReal Pointwise

/- Separability passes to the monoid generated by a set by taking pointwise
powers (finite products in the given order). -/
private lemma monoid_sep {X : Type*} [Monoid X] [TopologicalSpace X] [ContinuousMul X]
    {s : Set X} (h : TopologicalSpace.IsSeparable s) :
    TopologicalSpace.IsSeparable (Submonoid.closure s : Set X) := by
  have hp (n : ℕ) : TopologicalSpace.IsSeparable (s ^ n) := by
    induction n with
    | zero =>
      rw [pow_zero]; exact (countable_singleton (1 : X)).isSeparable
    | succ n ih =>
      rw [pow_succ, ← image_mul_prod]; exact (ih.prod h).image continuous_mul
  refine (TopologicalSpace.IsSeparable.iUnion hp).mono ?_
  intro x hx
  change x ∈ Submonoid.closure s at hx
  induction hx using Submonoid.closure_induction with
  | mem x hx => exact mem_iUnion.mpr ⟨1, by simpa using hx⟩
  | one => exact mem_iUnion.mpr ⟨0, by simp⟩
  | mul x y _ _ hx hy =>
    obtain ⟨n, hn⟩ := mem_iUnion.mp hx
    obtain ⟨m, hm⟩ := mem_iUnion.mp hy
    exact mem_iUnion.mpr ⟨n+m, by rw [pow_add]; exact mul_mem_mul hn hm⟩

private theorem comp_cont (X : Type) [NormedAddCommGroup X] [InnerProductSpace ℂ X] [CompleteSpace X] :
    ContinuousMul (X →L[ℂ] X) := inferInstance
private theorem op_metrizable (X : Type) [NormedAddCommGroup X] [InnerProductSpace ℂ X] [CompleteSpace X] :
    PseudoMetrizableSpace (X →L[ℂ] X) := inferInstance

variable {G : Gauge} {L : Register G} {S : Table L} {V : Chamber S timeAxis} (A : Spread V)

private lemma generator_sep (h : Theme V A) (hs : Steady V) :
    TopologicalSpace.IsSeparable A.generators := by
  classical
  let B (n : ℕ) (p : Caps n) (i : Fin n) : Module.Basis (L.coord (p i)).Index ℂ (L.Ref (p i)) :=
    Pi.basisFun ℂ _
  let D (n : ℕ) (p : Caps n) (e : ∀ i, (L.coord (p i)).Index) : Set V.VacuumOp :=
    (fun x => (depot V A x p (fun i => B n p i (e i))).val) '' conf n
  let W := ⋃ n, ⋃ (p : Caps n), ⋃ e, D n p e
  have sep : TopologicalSpace.IsSeparable W := by
    refine TopologicalSpace.IsSeparable.iUnion fun n => TopologicalSpace.IsSeparable.iUnion fun p =>
      TopologicalSpace.IsSeparable.iUnion fun e => ?_
    let v (i : Fin n) : L.Token := ⟨_, B n p i (e i)⟩
    exact (h.steep n v).continuousOn.isSeparable_image (TopologicalSpace.IsSeparable.of_separableSpace _)
  have in_span (n : ℕ) (p : Caps n) (x : Points n) (hx : x ∈ conf n) (v : L.Vector p) :
      (depot V A x p v).val ∈ Submodule.span ℂ W := by
    obtain ⟨U,hU⟩ := h.array n p x
    let T := A.algebra.subtype.toAlgHom.toLinearMap.compMultilinearMap U
    rw [← hU]
    change T v ∈ Submodule.span ℂ W
    rw [Multilabel.expansion (B n p) T v]
    apply Submodule.sum_mem
    intro e _he
    apply Submodule.smul_mem
    change (U _).val ∈ Submodule.span ℂ W
    rw [hU]
    exact Submodule.subset_span (mem_iUnion.mpr ⟨n, mem_iUnion.mpr ⟨p, mem_iUnion.mpr
      ⟨e, x, hx, rfl⟩⟩⟩)
  apply (show TopologicalSpace.IsSeparable (Submodule.span ℂ W : Set V.VacuumOp) from sep.span).mono
  rintro y ⟨w,d,hw,rfl⟩
  have hx : positions w ∈ conf _ := hw.2.1.1
  have hy := in_span w.length (fun i => (tokens w i).1) (positions w) hx (fun i => (tokens w i).2)
  change (A.slot w d hw).val ∈ Submodule.span ℂ W
  rw [← spots A hs hw]
  simpa [depot,hx] using hy

theorem answer : YM.Bid.B12 := by
  intro G L S V A _H h hs
  have sep := generator_sep A h hs
  have hU : TopologicalSpace.IsSeparable ((StarAlgebra.adjoin ℂ A.generators : StarSubalgebra ℂ V.VacuumOp) : Set V.VacuumOp) := by
    haveI : ContinuousMul V.VacuumOp := comp_cont ↥V.D
    change TopologicalSpace.IsSeparable ((StarAlgebra.adjoin ℂ A.generators).toSubalgebra.toSubmodule : Set V.VacuumOp)
    rw [StarAlgebra.adjoin_eq_span, ← image_star]
    exact (monoid_sep (sep.union (sep.image continuous_star))).span
  have hall : TopologicalSpace.IsSeparable (A.algebra : Set V.VacuumOp) := hU.closure
  haveI : PseudoMetrizableSpace V.VacuumOp := op_metrizable ↥V.D
  haveI : SeparableSpace ↥A.algebra := hall.separableSpace
  exact ⟨denseSeq _, denseRange_denseSeq _⟩
end YM.Work.B12
