lemma jollity (k:ℕ):
    let b:=budgetsP M' (R.target (A.B.a.clock.J (m+1)) (A.B.a.clock.J m)) k
    let r':= (A.B.a.clock.hatBeta (m+1))*prices M' 0
    let t(d:Shade)(j:R0):=matin (M d) (houseS (Q d).body i) ((align H V he S m r hr hx hm Q d i).furrow j) Chi.canonical
    Nonempty (Atlas (p1) spreadK (fun d j x=> x.read (t d j)) (fun _=> r'+r')) ∧ Nonempty (Atlas (favor R (H.charts m hm) M' y k) spreadK (fun d j=> masked (A.B.a.budget m).threshold (locus M' (H.charts m hm).atTopH y j) (t d j)) (fun _=> b+b)) ∧ Nonempty (Atlas (mantleX A m n k) spreadK (fun d j x=> tonic (pupil (Q d).body i (M d)) j x) (fun _=> b+b)) := by -- Mallow.tonic implicit
   intro b r' tB
   let v(d:Shade):= rider H V S r d.val (m+1) hm
   have ht:= waved H V S r (m+1) hm
   have hc:= land (A:=A) hG N (m+1) hm
   obtain ⟨hQ,hR,hK⟩:= Dales.opened R hG t w0 X! hP0 u hc M' hM y hq spreadK k _ v (fun i=>spends H V he S r (m+1) i hm) ht.1 ht.2
   refine ⟨?_,?_,?_⟩
   · let s d : (pasture R (H.charts m hm) M' y).Slot:= fun j x=> x.read (tB d j); have he': s= costsR R (H.charts m hm) X! M' hM y Γ ∘ v:=by
        funext b j x; exact congr_arg (fun t=> x.read (F:=ℝ) t) ((verses H V he S m r hr hx hm M' hM Q M htM hy i b).1 j).symm
     change Nonempty (Atlas (pasture R (H.charts m hm) M' y) spreadK s (fun _=> r'+r')); rw [he',show r'=_ from congr_arg (·*prices M' 0) (PriceCompiler.beta_eq A.B.valid m)]; exact hQ
   · have h:(masksT R (H.charts m hm) (H.W (m+1)) M' hM y Γ ∘ v)= (fun d (j:R0)=> masked (A.B.a.budget m).threshold (locus M' (H.charts m hm).atTopH y j) (tB d j)):=by
        funext b j; exact congr_arg (fun t:Config G (A.B.a.S.side m n)→ℝ=> masked (A.B.a.budget m).threshold (locus M' (H.charts m hm).atTopH y j) t) ((verses H V he S m r hr hx hm M' hM Q M htM hy i b).1 j)
     rw [← h]; exact hR
   let p d:= Mallow.tonic (pupil (Q d).body i (M d)); have hk: earsP R (H.charts m hm) X! M' hM Γ∘v=p:=by
     funext b j x; -- tonic uses derivative? inspect
     exact congr_arg (fun t=> deriv (fun z=> t z j x) 0) ((verses H V he S m r hr hx hm M' hM Q M htM hy i b).2)
   change Nonempty (Atlas (mantleX A m n k) spreadK p _); rw [←hk]; exact hK
