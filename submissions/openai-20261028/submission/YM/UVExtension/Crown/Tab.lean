   -- V shadow. fix
   intro t' w; let v:= snaps H V S r (b.val:ℂ); let beta:= faceV (R:=R) v
   have hx':= hx.trans m.le_succ; let h:=H.sprig V he S r hr b; have hP:(lock R (snaps H V S r (b.val:ℂ)) _ hm)= _:= (dif_pos (show m+1≤N from hm) : beta (m+1)= _).symm; exact Dales.prints (u:= w) R (w0) (X!) M' hM (h.alive _ hx' hm) (H.protector h _ hx' hm) hP.symm (M b) (htM _) (hy _) t' i
