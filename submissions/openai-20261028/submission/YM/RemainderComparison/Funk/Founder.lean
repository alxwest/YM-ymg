structure Tolled (P':BudgetPoint) (k:ℕ) : Prop where
   inputs (τ:Type)[Fintype τ][DecidableEq τ](J:Marker.Census τ)(a:τ→ℝ) (u:ι→ Poly J) : Serif.Chorus J a Z u k →
        ∀ (F:Tree.Forest S.ratio) (a':α)(V:Config G c), let A:= Creek.theater H χ M y l Z v
        S.push R.beta (Serif.TuneR (Typeface.brand M a') Z l v u S) V =
         ((↑(overhead (prism T x χ o.K V F) R Q.table)):ℂ) • (GridRenewal.Rain.cyclone (A.basin P' (Creek.Academy H χ M y l Z v k) Z u a' V)*(∑' i,(Flues.kettle H χ M y l Z v H' D' f₁ f₂).gala P' Z u a' V i))
variable (h:Treasury (G:=G) (L:=L) Ω Λ Ha P' R.beta x) (U':Muse.Pad H Λ.view χ)(hh:Muse.Roles H χ U' Λ.k Λ.s Λ.rise Λ.sharp Λ.a Λ.Delta Λ.epsi Λ.Y Λ.pV Ha.Y Ha.spin Ha.e Ha.t)(hp: Motto (Typeface.brand M y) l v H bA Λ.Y Ha.Y Λ.sharp)
include h hp hh
lemma tolling (χ':Chi) (_h:χ'=χ) : Tolled H M y l Z v H' D' f₁ f₂ (χ:=χ) P' Λ.k:=by
    constructor; intro τ _ _ J a u hq F α V A; have hp':= Typeface.outputs H M y α l v hp; let Gs (i:Sleet.Staff (brand M y) H):= Serif.glyph (brand M α) H χ Z l v u i V
    obtain ⟨hU,hT,hK⟩:=Serif.laws (brand M α) H χ Z l v U' hh hp' u hq H' D' P' f₁ f₂ V h.pose h.pose2 h.pose3 h.pose4 h.support F
    have hv i:A.paint P' Z u α V i=Gs i:= Creek.stony H χ M y α l Z v u P' i V h.pose2 -- order!
    have he: ∑' i,Gs i=Manor.basin A P' K₀ Z u α V:=by
       unfold Manor.basin; rw [← tsum_subtype_eq_of_support_subset (show Function.support Gs⊆K₀ from ?_)]  
       · refine tsum_congr fun i=> (hv _).symm -- edit
       intro i hi; by_contra hx; apply hi; rw [← hv]; exact Creek.onCampus H χ M y α l Z v u hq P' i V hx -- order args
    have hW : (∑' i,(Tʼ).gala P' Z u α V i) =(∑' i, Serif.book (brand M α) H χ Z l v u H' D' P' f₁ f₂ V i):= (Flues.origin H χ U' M y α l Z v hh hp u hq H' D' P' f₁ f₂ V h.pose hh.price.visit.posts).tsum_eq -- use hp not shadowed
    rw [← he,hW]; exact hK
