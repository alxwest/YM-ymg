    refine ⟨ρ,He,fun H X'=>⟨fun i'=>he i' _,?_,fun U U' ℓ hH u hh R' H' he' a' d=>?_⟩⟩
    · obtain ⟨w₁,h,_⟩:= Musicology.inherited q H; exact ⟨w₁,h⟩
    exact Hymnal.vesper F y hG w b hp hm hβ α₀ hL hn H Φ χ' ρ He X' u hh hq ht hr U U' ℓ hH (fun i'=>he i' _) H' he' a' d C_ hc
