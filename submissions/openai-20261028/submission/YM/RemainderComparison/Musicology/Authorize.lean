    ∀ (H:Guide A.B F.shape N m n R), ∀ (X':∀ i':Stars,Fragment G (C' i') α (ι i') (κ i')),
       (∀ i':Stars,Cadenza.Cleat (q) (Y) (P₀) r t (D') X.p.kernel χ (Hymnal.audience F w b α₀ Φ χ' ρ He X' i') (A.B.a.budget m))∧ (∃ w:ℕ→ℝ,Halo.Presents R Set.univ w (incomingE G L δ))∧
       ∀ (U:Manor G Ox Void α δx) U' ℓ, Hymnal.Pollux F y w b α₀ H Φ χ' ρ He X' U U' ℓ → ∀ (u:ℝ), (∃ w:ℕ→ℝ,Halo.Presents R Set.univ w u∧ u ≤ incomingE G L δ) →
          ∀ (R':Rep G (A.B.a.S.side (m+1) n))(H':Guide A.B F.shape N m n R')(h:Match.Alliance H' H 1 0) a' d, Hymnal.Sunset F y w b hp α₀ H Φ χ' ρ He X' u U H' h a' d C_:=by
