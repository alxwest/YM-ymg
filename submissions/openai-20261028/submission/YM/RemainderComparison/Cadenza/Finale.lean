lemma allLit : ∃ U': Talon, let t':=(Cargo.wall Q A₀ F K₀ Rt C' S' U')ᶜ
          Tolled H M y l Z v H' X u' v' (χ:=χ) B r.k ∧ (∃ I,Striped Q A₀ F K₀ V E₁ Rt C' S' U' I) ∧ Underscore Q A₀ F K₀ Z Rt C' S' o' Wc U' w B ∧ Thesaurus Q A₀ F K₀ Z Tʼ Xa hF Rt C' S' o' Wc U' w B (t.z x) (t.k x) r.k r.σ d₀ b₀ KY uPO u₁∧
           Manor.Spinal Mʼ t' Rt B r.σ KV∧ Manor.Templary Mʼ (t'∩ Lobby.night Mʼ Z) Rt B r.σ OW ∧
           d₀+OW ≤ (C₀/p.L.val+δ')*U + Πx*δQ + Πx*v ∧
           b₀+KV ≤ Πx*(δQ+(v+U)) ∧
           (1+|ϕ x|)*(b₀+KV) ≤ gStep R.beta^(((r.p+1:ℕ):ℝ)-η)+(1+|ϕ x|)*Πx*(v+U):=by
    have hP : inBand (betaF G x p.L) R.beta:= Muse.strong H
    obtain ⟨hA,hO,hx₅,hΓ⟩:=hx.active R.beta B hB hP
    obtain ⟨hE,hN,hK⟩:=hx.stamps.learns B hB c f S T hp hs R _ H
    obtain ⟨wH,hV,hW⟩:=hf.light.regular
    have hxV i:= Cadenza.birth Q A p r s t E' D K E C D' χ Jv B _ _ _ hx hB (C' i) (he i)
    have hxA i:= Cadenza.birth Q A p r s t E' D K E C D' χ Jv B _ _ _ hx hB (S' i) (hd i)
    obtain ⟨Y,hY⟩:= hE.arms
    obtain ⟨q,d,vP,tP,A',b,r0,B0,b',n,⟨N⟩,z,hN',hV0⟩:= hN.consensus
    have hh':Caretaking H Λ Ha M y l Z B' v (χ:=χ) (σ:=r.σ) B πCost (D.Rb x) := ⟨⟨Y,hY⟩, hK.earns _ _ _ hV hW hk hG C₀ hq hQ hL,(Creek.stake H χ M y l Z v B N hB.pressure hN.horizon (Nat.le_refl _) hB.pose hN').skim (Set.Subset.refl _) hV0 le_rfl⟩
    have hGx :Goods (r':=t.halo x) (z:=t.z x) (n:=t.n x) (k:=t.k x) (m:=t.ℓ) (σ:=r.σ) (P':=B) (Ω:=K) (B':=D.Rb x) (p₁:=πCost) H Λ Ha M y l Z B' v C' S':= ⟨hA,⟨hr.stores,hO.pos,hr.light⟩,shelter Q A K χ (C' 0) hA (hf.beauty 0).1 (hxV _).1 y,hxV, fun i=>(hxA i).1,hh',hO.set ht⟩ -- danger v' Γ var
    obtain ⟨hi,hδ,-⟩:=hf.light.account
    have hv : v ≤ 1:= (le_mul_of_one_le_left hi hY.allowed).trans hδ
    obtain ⟨u'',vZ,z',he'⟩:= hx₅.resonance _ Xa v hi hv
    let e' := prize p r s t E' D hB hA.coup hi hv
    rw [e'.1] at he'
    obtain ⟨U₀,hT,hFp,hU,hℒ,hX,hκ⟩:= Funk.wisps H Λ Ha M y l Z B' v F E₁ ℓ V H' X u' v' Xa hF C' S' o' Wc w hGx hf he'
    have hx₁:= shares p r s t E' D hB R.beta
    have hxΓ:= Cadenza.totals p r s t E' D _ _ hΓ (show 0≤gStep R.beta from inv_nonneg.mpr (Real.sqrt_nonneg _)) v U C₀ hi hV.positive
    refine ⟨U₀,hT,hFp,hU,?_, hX,hκ,hxΓ⟩
    rw [e'.1, ← hx₁.1,←hx₁.2,← Expenditure.remits p r t D.Rb s.unsigned x Xa]; exact hℒ
