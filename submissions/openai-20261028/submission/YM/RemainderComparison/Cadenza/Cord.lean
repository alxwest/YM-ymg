-- vocal.seeds is before.A.I.ε.S slack
namespace Rays
variable (g:Rays)
structure Heart (P : RG.Stage) (a : ℝ): Prop where
   stores : 0 ≤ g.σ -- should require P.supportExponent too.Mail.
   just : P.supportExponent ≤ g.σ
   light : g.σ+1 ≤ g.a
   breadth : 0 < g.ε
   halls : g.a+3*g.ε ≤ a
   price : P.order ≤ g.law
   probe : P.order+(g.p+1)+g.p+2 ≤ g.arm
   absolute : g.p+1 ≤ g.s
   atHull : g.finalG+1 ≤ g.s
abbrev wind := g.arm+g.rank
end Rays
variable (g:Rays)(E E': RG.Stage)
structure Temper (P₀:BudgetPoint)(P': RG.Stage)(x:ℝ) (G:Gauge)(L:Side):Prop where
    pose : P₀.B=radiusB x
    pressure : P₀.threshold=Pressure.temp x
    power : P₀.power=P'.power
    order : P₀.order=P'.order
    salary : P₀.supportExponent=P'.supportExponent
    pact : P₀.threshold≤2*Pressure.fiery G x L

