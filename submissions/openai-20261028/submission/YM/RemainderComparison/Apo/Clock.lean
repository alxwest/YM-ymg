lemma gift (hq': (Fintype.card (Site c):ℝ) ≤ Ωb) :
      ∃ (S: Finset (Staff (brand M x') H)) (A:Finset β), ∀ (U:Finset (Staff (brand M x') H)) (V':Finset β), (↑U:Set Tt)⊆ So ∩ O → (S:Set Tt)∩(So∩O) ⊆ (U:Set Tt) → (↑V':Set β)⊆ Fa1→ (A:Set β) ∩ Fa1 ⊆ (V':Set β) →
       Strikes H χ M x' l δ P' Fa Y' Fa1 (k':=k') ρ (sig:=sig) A' (pΘ*skyFare P'.order r' s' sig (qB x) (f' x) wp Ωb) U V':=by
    have hβ':0<gStep R.beta:= (Fare.gS _ H.laws.intake.positive).1
    have hx':0 < pΘ:= pow_pos hβ' _
    have hF:= Breeze.refers P' hγ hz
    have hF': Manor.Spinal Fa Fa1ᶜ o' P' a pΘ:=(Breeze.sung (A:=Fa1ᶜ) P' hγ hz (Set.subset_univ _) (fun i hi=> hp' i hi)).skim (Set.Subset.refl _) hhT le_rfl
    have hcap:= Apo.cap H χ M x' l δ Y' hV
    have he0 : Manor.Spinal A₀ So Rt P' a (Y^k*γ):=(Creek.mass₀ H χ U M x' l Set.univ δ h hh P' hx ht hk hK).skim (fun i hi=> (hcap hi).2.1) le_rfl le_rfl
    have hy0: Manor.Spinal A₀ (So \ O) Rt P' a (4*pΘ):= (Creek.glimpse H χ U M x' l Set.univ δ h hh P' hx ht hk hK ∅ F' H' hY wR wV hW).skim (fun i ⟨hi,h⟩=>⟨hcap hi,h⟩) (mul_le_mul_of_nonneg_left (pow_le_pow_of_le_one hβ'.le hβ hv) (by norm_num)) le_rfl
    obtain ⟨S,hS⟩:=(Breeze.Cut.rest P' he0 _ hx').exists
    obtain ⟨a',hA⟩:=(Breeze.Cut.rest P' hF _ hx').exists
    refine ⟨S,a',fun tA tB hT hTS hB hBS=> ⟨⟨hT.trans Set.inter_subset_left,hB⟩,fun α=>?_⟩⟩
    intro g; have ht':Manor.Spinal Fa (tB:Set β)ᶜ o' P' a (pΘ*2):=by
       apply (hF'.swell hA).skim ?_ (le_of_eq (by ring)) le_rfl; intro i hi; by_cases hg:i∈Fa1; exact Or.inr ⟨trivial,fun h=> hi (hBS ⟨h,hg⟩)⟩; exact Or.inl hg
    have hp: Manor.Spinal A₀ (So \ (tA:Set Tt)) Rt P' a (pΘ*5):=by
       apply (hy0.swell hS).skim ?_ (le_of_eq (by ring)) le_rfl; rintro i ⟨hi,h⟩; by_cases hg:i∈ O; exact Or.inr ⟨hi,fun hz=>h (hTS ⟨hz,hi,hg⟩)⟩; exact Or.inl ⟨hi,hg⟩
    have h:= viable H χ U M x' α l δ h hh P' Fa o' Y' ρ N r' q p' D A' hpS hpW hb hy hx ht hq hβ hC' hC he tA tB (hT.trans Set.inter_subset_left) (he0.skim (hT.trans Set.inter_subset_left) le_rfl le_rfl) hp (hF.skim (Set.subset_univ _) le_rfl le_rfl) ht'
    exact ⟨h.1,⟨fun x hx y v hp hQ=> (h.2.valid x hx y v hp hQ).trans (show pΘ*v₃+_*_+_*_ ≤ pΘ* _ from (by unfold skyFare; nlinarith only [mul_le_mul_of_nonneg_left hq' hx'.le]))⟩⟩
