           Manor.Spinal M₀ T' Rt B (r).σ 𝓢∧ Manor.Templary M₀ (T'∩ Lobby.night M₀ Z') Rt B (r).σ ℒ ∧
           d₀+ℒ ≤ (C/(P₀).L.val+(x).ξ)*B₀ + Πx*Ξ + Πx*θ ∧
           b₀+𝓢 ≤ Πx*(Ξ+(θ+B₀)) ∧
           (1+|(x).η_goal δ|)*(b₀+𝓢) ≤ gStep R.beta^((((r).p+1:ℕ):ℝ)-(x).limit)+(1+|(x).η_goal δ|)*Πx*(θ+B₀):=by
   obtain ⟨hr,hp,hq,hX⟩:= Hymnal.pref F y hG w; obtain ⟨⟨hK,hS⟩,hA,hH⟩:= Hymnal.budgets F hm hl hβ
   obtain ⟨q,hc'⟩:= Hymnal.quota F y hG
   have hh: R.p=V:= hc.trans hl.point
   have hz: Release.accepts (F.span j i) R.p.supportExponent (squash E') L:= hh.symm ▸ (hc' m).2.1
   exact Cadenza.allLit K₀ (Y) P₀ r (U) t E' (D') X.p.kernel (X.p.profile j) (Z) (F.recordP j i) Chi.canonical H I X' l Z' T₀ V₀ B S S₁ d F₁ Υ u v Xa hf X1 U₁ o' W_ μP (hX.expenses _ (A.B.valid.pays m)) hH hr patchA (protocol A.B hm F.pledging.conducts.full) (Hymnal.billed F _ hG w n) he hv hd (hc.symm ▸ hK) hA hz ht (hc.symm ▸ hk.symm ▸ hS)
