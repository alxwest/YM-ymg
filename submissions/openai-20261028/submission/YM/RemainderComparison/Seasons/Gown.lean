variable (ha: Gown F b y w)
include ha hm hL hb
lemma prismAny : (A₀).down.Bounds (A₀).low σ V₁ ℓ ∧ (A₀).low= Z ∧ WilsonStartup.Decent Z R₀ ∧ Geo.Width R₀ Z σ∧
       (p).supportExponent+3 ≤ (t).a∧ (t).a/(R₀).B ≤ σ/4 ∧-(ℓ)≤0∧ ℓ ≤ ConnectedActivityE6.loopBill G L x ∧ |Δ|≤ K:=by
    have hH:= ha.revenue
    have hx:= Hymnal.budgets F hm hL hb|>.2.2
    have hk:= params_eq A.B.valid m
    have hr := A.B.support.cap N m hm.le
    have h_dir : (Z).direct ≤ 1:= hk ▸ Canonical.direct_le_one hr.metric
    have hh': (p).supportExponent+3=(t).a:= ha.kinetic.symm
    have hg : 0≤ ℓ ∧ ℓ ≤2*Vac.Numbers.P x:= Pane.coverBill A.B.a m
    have hu := A.B.support.kinetic N m hm; let v:=G.slopeConstant*Real.log (D.L j).val
    have hp : |Δ|≤|Δ+v|+|v|:=by have he := abs_sub (Δ+v) v; simpa only [add_sub_cancel_right] using he
    have he := PriceCompiler.params_eq A.B.valid (m+1); have hh := PriceCompiler.block_eq A.B.valid m; rw [he,hh] at hu
    refine ⟨?_,(congr_arg RG.Stage.clip hk), (hH.width R₀ hx).1 h_dir,(hH.width R₀ hx).2, hh'.le, hh' ▸ ((hH.generalR.package R₀ hx).1),neg_nonpos.mpr hg.1, hg.2.trans (Pane.brace _ hH.begins.2), ?_⟩
    · have hp' : (A₀).down = A.B.kin.path N m:= rfl
      rw [hp', ← hk]; exact hr
    unfold Pane.cloak; dsimp only [v] at hp; linarith only [hp,hu]
