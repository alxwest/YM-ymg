/-!
# Stock needed at the gate :: UNMARKED density and normalization

Intermediate certificate (day or night). Single unmarked inputs (density
and scanner checks as well as holes/K normalization). Only uses W type
to ask for the exact matching *unmarked* data of that syntax. Still to
obtain this certificate from more primitive inputs (see Stocking, Plough).
`shutters`: from here Dark (raw estimates incl support & push)
below the upper stretch. (Upper stretch, Festival.)
-/
set_option autoImplicit false
noncomputable section
namespace YM.PhysicalNext.InteractingRank.Display.Docking
open Lattice Wilson Pressure RG Next.SectorChange SectorNext.Vacuum Next.Rank Next.Rank.Perch Tapes Peak Flux Marker Ac Corona Value Precision RankCovariance Push.SectorMeasure
open scoped Topology BigOperators Classical
variable {G : Gauge} {c f : Side} {S : StepData c f} {x β w e L z h y M a : ℝ} {T : Tube G S}
    {J : ChartRatio G} {Y : Lantern G S} {D : Allocation G S x w}
section
variable (P : Rep G f) (Q : Rep G c)
    {k : Teller G} (A : Boosted T k x) (hP : 25*radiusB x+30≤Q.p.B)

/-- `M` large (landed); `L` light; `δ` unmarked nonnegative tilt income.
r parameter is the AFTER-rate on polynomials; all quiet in `p`.
Kept from one branch. -/
structure Fireplace {w} (J : ChartRatio G) (Y : Lantern G S) (D : Allocation G S x w)
    (r : ℝ) (e M L δ h y : ℝ) : Prop where
  precompile : ∃ (ι : Type),∃ (_ : Fintype ι),∃ (V : ι→ Zest G S x Y.park Q.p.threshold) (Λ : Config G c → ℂ), BodyGrant T P Y D J Q.p.threshold V Λ ∧
      Holdings Q V T M L e δ ∧
       ∀ (W : Type), ∀ (_ : Fintype W) (_ : DecidableEq W), ∀ (θ : W→Site f) (u : W→Site c) (H : u=S.ratio.parent ∘ θ), ∃ B : Flux.Vac u Q,
         Reparations u Q B (fun _=>r) e L h y ∧ ∀ o c k v t (hp : P.Lawful o c k v t), ReturnTrip P Q V A hP H hp Λ B
end
section night
variable {C : Family G} {i k N p n : ℕ} {ξ : Purse}
    {g : Course C N p k} {B : Binding C} (ht : i<k)
    {P : Rep G (C.S.side (i+1) p)} {R : Rep G (C.S.side i p)}
local notation "X" => Atlas.clim C.path.levels i
local notation "V" => Atlas.clim C.path.levels (i+1)
local notation "U" => Atlas.clim C.path.levels k
local notation "L1" => ξ.era
local notation "E" => ξ.era.coast.e
local notation "Fn" => Ship.allowance C.path.levels 2 k
local notation "K" => kinetics U
set_option quotPrecheck false
local notation "BT"=> tunnel B N i p
local notation "St" => C.path.levels.clock.op i p
variable (hn : i<k)
include ht

end night
end YM.PhysicalNext.InteractingRank.Display.Docking
