lemma arete :
    (∀ i j, Shingle.Mild (B) univ (fun x=> Yd x i j) s) ∧
      ∀ i:Site A₀, Shingle.Mild (B) (neighbors e i) (fun x=> b₀ x i) s:= by
  have hK := h.conducts.machine.passes hm he; have hk := h.agenda _ _ (step_paid A.B.a m)|>.1
  have hv (i:Stars) :∀ j:Site (Rain.moor C A m i), Shingle.Mild B univ (fun x => Yd x i j) s:= W.attunes hm h.conducts.full hh h.jewels hK.1.decent ⟨hk,hx⟩ i (noteX H he) s (hc.beta.congr (fun i hi=> by change (Q (H.latch i)).beta=(Q i).beta; rw [Embrasure.click _ i hi]))
  exact ⟨hv,fun i=> Shingle.rising Pu hv (show tent k (radiusB x₀)+4 ≤ e from (by unfold Trio.base; omega)) i⟩
lemma blinking (_hU: ∀ x∈s, Meadow.Budget B H.doors.reg ((f₀ x).logRead) h₀) (hB:∀ x∈s, ∀ i:Site A₀,(B).supBounds i (neighbors e i) (beacons H he W d x i) (gleam (A:=A) (C:=C) (m:=m))): Compared (opening H) B (paint H he W d) s:= by
  let Hs x:=H.sister (H.latch x); let h₀':= (lights H he W d); let q:= uptick H d
  have hf:= Yearling.hearthcast h.conducts H he hc hh.year h.range hm
  obtain ⟨hq,hV⟩:= Rain.arete h hm H hc he hh hx W d
  let X:= (fun i:ℕ=> (pennant H.base i).2∉Meadow.bouquet H.base d)
  have he' : Compared H.doors B q s := Shingle.curtain hf X (fun _ _=>rfl) (fun y hy i=> by
    unfold q uptick; rw [Meadow.compass]; unfold X; split
    all_goals rfl)
  let V':= W.offers d
  have hs x (hx:x∈s) (i:Site (A.B.a.S.side m n)) : Varies (fun y=> i₀ y i) x s := by
    let D:ℝ→Trio.Offer G _:= fun y=> Meadow.barony (H.houses (H.latch y)) O d γ
    apply Shingle.lighting d H.base hf rfl (show ∀ x∈s,∀ i,(B).Regular _ _ from ?_) Pu hq (show tent k (radiusB x₀)+4 ≤ e from (by unfold Trio.base; omega)) i (D:=D) ?_ hx
    · intro y hy j
      rw [Beam.rewrite_rule]; exact (twined h hm H he hh y).smooth j
    intro y hy; let v:=H.latch y; have hu : (Q a).path=(Q v).path:= (he a H.he).1.path.trans (he _ v.2).1.path.symm
    exact Meadow.aster O B (Hs y) hu (Match.same_area hu (hc.reg _ H.he _ v.2) (hc.forced _ H.he _ v.2)) (H.agrees _) γ d i
  apply Shingle.tune («g»:= (beacons H he W d)) e (2*e) (fun x hx i=> (hV i).smooth x hx) hB (fun x hx i=> (worthy h hm H hc he hh (by assumption) W d x i).2.2) he' ?_ hs
    (fun x hx=> by obtain ⟨i,hi,hK⟩:= (twined h hm H he hh x).expensive; exact ⟨i,fun j=> (hi j).2⟩)
  intro x hx i ε hε; filter_upwards [self_mem_nhdsWithin, (hV i).budget x hx i ε hε] with y hy hv; exact (sup_varies (hV i|>.smooth x hx) (hV i|>.smooth y hy)).2 hv
