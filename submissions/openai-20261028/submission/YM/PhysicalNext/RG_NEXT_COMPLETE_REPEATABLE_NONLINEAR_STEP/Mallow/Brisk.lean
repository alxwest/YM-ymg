private lemma pelagic {a b c z p' s:ℝ}(hf:a+c=z-p')(h:Real.exp (z+b-p')=s): Real.exp a*Real.exp b*Real.exp c=s:=by rw [← Real.exp_add, ← Real.exp_add, add_right_comm, hf]; convert! h using 2; ring
