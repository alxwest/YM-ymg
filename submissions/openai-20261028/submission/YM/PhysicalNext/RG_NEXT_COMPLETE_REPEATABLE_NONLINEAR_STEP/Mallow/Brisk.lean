lemma curd (U:Config G (A.B.a.S.side m n))(θ:ℝ)(hθ:|θ| *jewelDebt M Y L y≤1): (black ((T₀).pours T') (shifting H x M θ)).gas B U= (black ((D₀).pours Tap0) (V θ)).gas B U*Real.exp (∑' i,(Tap0).logarithm i U):=by
  have hf:= money H x M o ho T hR h hp
  exact (Passage.gathered (F:=Marlin.hak D₀) (hearth hf (fanning hm H x|>.1) θ hθ) U).tsum_eq
lemma cord (U:Config G (A.B.a.S.side m n))(θ:ℝ)(hθ:|θ| *jewelDebt M Y L y≤1): (black (H.result x).activities (pupil H x M θ)).gas B U=(black ((T₀).pours T') (shifting H x M θ)).gas B U* Real.exp (∑' i,(T').logarithm i U):= by
  rw [Spring.owns g hm H hx]
  exact  final.slant (indoors hm H x M o ho T hR h hp) (plants g hm H x) θ hθ U -- defeq
omit hR ho hp h in
lemma cone (U:Config G (A.B.a.S.side m n)) : Real.exp ((H.result x).exponent U) * Real.exp (∑' i,(Tap0).logarithm i U)* Real.exp (∑' i,(T').logarithm i U)= overhead (prism H0 y O (R.shape.o J Jp).K U H.O) (Q x) (Y).table*(W).homesteadPool O U:=by
  have hp':=(R.machine.passes hm H.knows).1
  have hP: (H.result x).exponent U + (∑' i,(T').logarithm i U)=(V0).exponent U-gV*Collection.receipt M₁ (K).clip B U:= by
     rw [H.owns g hm hx, cruise_EX]; exact (H.core hm x hx).exponent g (A.B.support.cap N m hm.le) hp'.decent hp'.width gV (Return.enough_room ..) (Q x).beta _ U
  let s:= overhead (prism H0 y O (R.shape.o J Jp).K U H.O) (Q x) (Y).table
  exact  pelagic hP (prom hm H x T U)
