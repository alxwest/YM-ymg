lemma prom (U:Config G (A.B.a.S.side m n)) : Real.exp ((V0).exponent U+(∑' i,(Tap0).logarithm i U)- gV*Collection.receipt M₁ (K).clip B U)= overhead (prism H0 y O (R.shape.o J Jp).K U H.O) (Q x) (Y).table *(W).homesteadPool O U:= by
  let W':=H.H.base; let X:= posting B W'; let v:=H.H; let c:= v.payment H.O x
  have hz:= Embrasure.click H.H _ hx
  have hp : H.H.fullSong x= Song.plusone H.H.base f' O gV:=by unfold Embrasure.fullSong; rw [hz]
  have hξ : c=Song.weighty (W) Chi.canonical H.O:=by unfold c v Embrasure.payment; rw [hz]
  let M':=H.H.sister (H.H.latch x)
  have he : (Collection.frozen X M₁ (K).clip B (H.H.fullSong x) (Q x).beta c).exponent U=(V0).exponent U+ (∑' i,(Tap0).logarithm i U):= Marlin.cruiseV (B) H.H.doors e (2*e) (uptick H.H d x) _ _ U (R:=X) (H.H.fullSong x) (A.B.kin.path N m) (K).clip (Q x|>.beta) c (Meadow.barony _ O d gV 0 1) (H.funds x hx|>.1) (fun i=>Trio.levy B M' gV d (Rain.screens R.target A m) e (H.W.offers d (Rain.noteX H.H H.knows x)) i _ _ (twined R.pledging hm H.H H.knows R.inn _)) (fun s b=>Song.motion _ W' M' O gV s b) (fun s b=> Beam.moves W' B O M' s b _)
  rw [← he,hp,hξ]; exact Song.creditRing B H.H.base f' O gV T H.O rfl (Rain.jersey (A:=A) (m:=m)|>.1.le) (show (H0).down.Bounds (H0).low _ _ _ from A.B.support.cap N m hm.le) (H.H.honors x) U
