private lemma latchEq (F : Tap G (A.B.a.S.side m n))(Z:Code G (A.B.a.S.side m n)): black (Refrain.read H.H.base f' O (D₀).reg F.regular) Z=black ((D₀).pours F) Z:= rfl
omit hm g ho in
lemma crown (U:Config G (A.B.a.S.side m n))(θ:ℝ)(hθ:|θ| *jewelDebt M Y L y≤1):
    let a:=color M W O U θ; let f:= (black ((D₀).pours Tap0) (V θ)).gas B U; let b:=(Q x).beta; let s:=  overhead (prism H0 y O (R.shape.o J Jp).K U H.O) (Q x) (Y).table; s*(W).homesteadMill a*f=(S).push b (Q x).eval U+θ*(S).push b M.cicada U:=by
   intro a f b s
   let G₀ := (Refrain.read H.H.base f' O (D₀).reg (Tap0).regular); let Tanga:=black G₀ (V θ)
   have ht : Tanga.gas B U=f:= congr_arg (fun i:Activities G (A.B.a.S.side m n)=> i.gas B U) (latchEq H x Tap0 (V θ))
   refine (congr_arg ((s*(W).homesteadMill a)*·) ht.symm).trans ?_
   exact Charity.fresh M W T h B H.H.base f' (D₀).reg (Tap0).regular U θ rfl (raindance M W T (hR J y (A.B.valid.pays m) _ (step_paid A.B.a m)|>.1.1) hp) hθ H.O
lemma floats (U:Config G (A.B.a.S.side m n))(θ:ℝ)(hθ:|θ| *jewelDebt M Y L y≤1):
    let a:= color M (W) O U θ; let u:=pupil H x M θ; let b:=(Q x).beta
    Real.exp ((H.result x).exponent U) * (W).homesteadMill a/ (W).homesteadPool O U*(black (H.result x).activities u).gas B U=(S).push b (Q x).eval U+θ*(S).push b M.cicada U:=by
  intro a u b
  have hf:= money H x M o ho T hR h hp
  let f:= (black ((D₀).pours Tap0) (V θ)).gas B U
  have he: (black ((T₀).pours T') (shifting H x M θ)).gas B U=f*Real.exp (∑' i,(Tap0).logarithm i U):= curd hm H x M o ho T hR h hp U θ hθ
  have hQ: (black (H.result x).activities u).gas B U=(black ((T₀).pours T') (shifting H x M θ)).gas B U* Real.exp (∑' i,(T').logarithm i U):= cord g hm H x M o ho T hR h hp U θ hθ
  let s:= overhead (prism H0 y O (R.shape.o J Jp).K U H.O) (Q x) (Y).table
  have hM : Real.exp ((H.result x).exponent U) * Real.exp (∑' i,(Tap0).logarithm i U)* Real.exp (∑' i,(T').logarithm i U)=s*(W).homesteadPool O U:= cone g hm H x T U
  have hw : 0 < (W).homesteadPool O U:=by have hp:= (W|>.threshold_logPool O U (H.H.honors _)).2; rw [← hp]; exact Real.exp_pos _
  have ht : s*(W).homesteadMill a*f=(S).push b (Q x).eval U+θ*(S).push b M.cicada U:= crown H x M T hR h hp U θ hθ
  refine (?_ : _=s*(W).homesteadMill a*f).trans ht
  rw [hQ,he]; exact mist hM hw _ _
