-- Version where extra SIGN supply is only on bounded supported directions at Δ.Root Rap.Clock. Combine here before invoking Euler; matrix uses exact protocol and buys those Ward dims only.
lemma stencil8 {ε W:ℝ} (hW:0≤W)(G':Legato.Pads8 (M:=M) D C Q R B.span ε A.delay)(hw:Legato.raft D 2 A.delay)(hS:G.Simple) (hi: ((F).grades i).2=2)
    (hd:d+3≤ T)(hS':d≤J)(hT: Blend 2 (B₂).threshold (B₁).threshold)(hJ:4≤ A.B.a.clock.J m)(hD : Push.Local.Readable (hol G) S! B₁ n₀ (authors A.B.a m))
    (hF:∀ (η:ℂ→L[ℝ]ℝ)(γ:∀ x:ℂ,‖η x‖ ≤ ‖x‖),‖η‖≤ 1 → ∀ Z':Directions G n₀,(B₁).dirBound 0 Z' →
      (∀ i:Bond n₀,i.1 ∉ Yp → Z' i=0) → ‖Z'‖ ≤ canopyW G L (B₁).power y →
      ‖leftDerivs (Charity.matin (C? η γ) Z (icon Z Ω) Chi.canonical) [Z',Z'] 1-leftDerivs (g! η) [Z',Z'] 1‖ ≤ W):
    let Z':=W+(y^ε)/y; let c:= Cub.cistern (G:=G) d*((L).val:ℝ)^d*(Z'+Z') + (y^2)⁻¹
    let P :=Warehouse.flight (Issue.trail V) N m; let hf:= PPX.Seal.donne S! (sound G d) M.p.kernel.penalty_pos hJ (Next.Foundations.valuation G d) P hS' hT
    let k := Local.weighted (hol G) (F) 0 Yp χℓ (F0)-hf.leads L (Place.copy F i)
    (F).coeffSize (Spins.four (F) k) ≤ Local.testPrice F*(c+4* Cub.cistern (G:=G) d*((L).val:ℝ)^d*((y^ε)/y)):=by
      intro Δ C' P' H' K'
      let X₀:ℝ:=y^ε/y; have hx:= (A.B.a.fits.delayed m).le; have hy:0≤ X₀:=by unfold X₀; positivity
      -- extension of signs to long-range via crop.Bridge price of g vs cropped g uses primary payment already. Can't assume groves local w/o further.
      have hv:= (united (n:=n) hm hP hp hV); have hB:(K z).p=B₂:= (H.knows _ z.2).1.point; rw [← hB] at hv
      have he := A.B.valid.pays m
      obtain ⟨aF,b,y₀,g,vα,Y',p₁,B',g',e,ν,hX,hY,N'',hη⟩:= (hC _ _ he _ hb.1).1.2 _ _ _ _ (Opera.protocol A.B hm B.pledging.conducts.full (n:=n)) _ _ Z
      have hn:=Rain.jersey (A:=A) (m:=m)|>.1
      let t:= Yp; let g (U:Directions G n₀)(i:Bond n₀):= if i.1∈ t then U i else 0
      have hF'(η:ℂ→L[ℝ]ℝ)(γ:∀ x:ℂ,‖η x‖ ≤ ‖x‖)(hh:‖η‖≤1)(U:Directions G n₀)(hu:(B₁).dirBound 0 U):
          ‖leftDerivs (Charity.matin (C? η γ) Z (icon Z Ω) Chi.canonical) [U,U] 1-leftDerivs (g! η) [U,U] 1‖ ≤ W+(X₀+X₀) :=by
        let V':=g U
        have ht(v':Directions G n₀)(i:Bond n₀)(hi:i.1∈t):g v' i=v' i:= if_pos hi
        have hfP: (B₁).dirBound 0 V':= by
           intro i; change ‖ite _ (U i) 0‖≤ _; split; · exact hu i
           rw [norm_zero]; positivity [(B₁).threshold_pos]
        have hE:∀ i:Bond n₀,i.1∉ t → V' i=0:=fun _ he=> if_neg he
        have hk0: (Brim.plate (houseS H z) (badge G n₁ d)).site=(0:Site n₀):=zeroO H z h!
        have hh' :coverNumber (B₁).B t ≤ (B₁).B:= (shells hm hP hp hc hb hV H z h!).2
        have hV': ‖V'‖ ≤ canopyW G L (B₁).power y:=by
           refine pacing V' t hE B₁ (o:=(0:Site n₀)) ?_ rfl hfP y L hh' ?_
           · rw [← hk0]; exact (Brim.plate (houseS H z) Ω).anchor
           rw [← (Circlet.shifting (A:=A) (m:=m)).1,← hB]; exact hv.1.rehearsed.tensions.coarse
        have hV'':= chorus8 hm hP hp hc hb hV H z hz h! i G' hi η hh
        let F':= C? η γ; let S:= Charity.matin F' Z (icon Z Ω) Chi.canonical; let W':= g! η
        let U':= deem 0 y (V1) (η ∘ f!)
        let w0(«F»:Config G n₀→ℝ)(«Z»:Directions G n₀):= leftDerivs «F» [«Z»,«Z»] 1
        let j:Tree.Forest (X).ratio:= (@Classical.choice _ (Tree.select _ (X).patch.odd_side))
        have ha: LocalOn t U':= cabin (mapcase Z Ω j) (V1) (η ∘ f!) _ (by rw [signboard (K z) h!]; exact ankle) -- apply at key? anchor at 0 via signboard
        have h': LocalOn t S:=(cornice Z F' Ω rfl v Chi.canonical N'' hv.1 hη hn.le).sites
        have he0 (F':Config G n₀→ℝ)(h:LocalOn t F'): w0 F' U=w0 F' V':=by simpa only [List.map_cons,List.map_nil] using Blaze.March.stays (g:=F') h [U,U] g (fun i _ j hj=> ht i j hj) (1:Config G n₀) 1 (fun _ _ _=>rfl)
        change ‖w0 S U-w0 W' U‖ ≤ _; rw [he0 S h']
        refine (norm_sub_le_norm_sub_add_norm_sub _ (w0 W' V') _).trans (add_le_add (hF _ γ hh _ hfP hE hV') ?_)
        apply (norm_sub_le_norm_sub_add_norm_sub _ (w0 U' U) _).trans; conv_lhs => lhs; rw [he0 U' ha]
        exact add_le_add (hV'' _ _ hfP hfP) (by rw [norm_sub_rev]; exact hV'' _ _ hu hu)
      apply (Cub.coda8 hm hP hp hc hb hV hC H z hz h! i (add_nonneg hW (add_nonneg hy hy)) G' hw hS hi hF' hd hS' hT hJ hD).trans_eq
      unfold C' Δ X₀; ring -- addition should be discrepancy c +4*A*X, not 2*... !
