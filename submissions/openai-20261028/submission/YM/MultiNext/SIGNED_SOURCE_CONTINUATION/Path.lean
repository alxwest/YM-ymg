import YM.MultiNext.SIGNED_SOURCE_CONTINUATION.Rungs

set_option warningAsError false

/-!
# Exact history of a comparison
All on the actual C. Addresses & complementary rescaling
as in `Passage`, an input on single steps. No extraction assumptions here,
and NO choice of subsequences to make singleton coefficients line up.
The matching coefficient is generated by the continuation.
-/
set_option autoImplicit false
noncomputable section
namespace YM.MultiNext.SignedSource
open Function Filter MeasureTheory RG Wilson Lattice Labels Source Bid
open Push.RelayDifference
open scoped Topology ContDiff Matrix.Norms.Frobenius BigOperators

variable {G : Gauge} {N i p e : ℕ} {C : Family G} {W : Worth}
open Body Extraction Extraction.Lease
variable (H : C.Makes) (T : Passage C e N p W)

abbrev Notes (C : Family G) (e p : ℕ) := ∀ i : ℕ, Inks C e i p

structure Traverse (H : C.Makes) (N p e : ℕ) (D : Coefficient (C.labels.level e) (C.side N p))
    (i : ℕ) (Y : Notes C e p) (b : ℕ → ℝ) : Prop where
  paid (j : ℕ) : i ≤ j → j ≤ N → Shod N (Y j) (b j)
  label (j : ℕ) : i ≤ j → j ≤ N → Boots N (Y j)
  runs (j : ℕ) : ∀ h : C.ref e ≤ j, i ≤ j → ∀ he : j < N, StepOne H h he (Y (j+1)) (Y j) (b j)
  pins : coord (Y N)=D.x
  force : flag (Y N)=D.forced
  canon : weighs N (Y N)=D.density 0 (C.localSection e) (C.path.rep N p N)

include H T




/-- Since `Solo` asks for literal indexed coefficients on all cutoffs,
we record them here on the given one for eventual splicing. -/
structure Book (C : Family G) (N p e : ℕ) where
  page : ∀ j, Coefficient (C.labels.level e) (C.side j p)
  ticket : ℕ→ℝ
  change : ℕ→ℝ
  total : ℝ
variable {V : Trial C}




end YM.MultiNext.SignedSource
