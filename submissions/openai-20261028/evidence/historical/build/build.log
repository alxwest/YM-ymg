    (fame : Real.exp ((s.profile i).supportExponent + 2) ≤ x) (stars : ∀ n ≤ j, Snow G (D.L j) n (R.μ j i) x q)
    (framesE : ∀ d ≤ j, |priceE ((Labels.frames G).level d) (priceS (s.profile j)) (fundsM G j d v)| ≤ x)
    (framesK :
