  YM.PhysicalNext.Repeat.Mallow.Snowy.framesE : ∀ d ≤ j,
      |priceE ((Labels.frames G).level d) (priceS (s.profile j)) (fundsM G j d v)| ≤ x
  YM.PhysicalNext.Repeat.Mallow.Snowy.framesK : ∀ d ≤ j,
      |priceK Θ₁.price (X₀ j) (Doors.rate (D.L j)) (D.L j) ((Labels.frames G).level d) (fundsM G j d v)| ≤ x
constructor:
  YM.PhysicalNext.Repeat.Mallow.Snowy.mk {G : Gauge} {s : Sheet G} {K : MapPrices} {X : Targets s K} {D : Rolls s}
    {p : Expenses X} {u : Return.Wages} {l : ℕ → ℝ} {q : ℝ} {R : Register D p u l} {X₀ : ℕ → ℝ}
    {Θ₁ : Luna.Tableau q 300} {v : ℕ → ℕ → ℝ} {j i : ℕ} {x : ℝ} (up : Tariff (X j i) (D.L j) 1 (R.μ j i) x)
