    "def LatticePlaquette.boundaryLinks {d N : \u2115}",
    "def GaugeConnection (G : Type*) (d : \u2115) (N : \u2115) := LatticeLink d N \u2192 G",
    "def plaquetteHolonomy (U : GaugeConnection G d N) (p : LatticePlaquette d N) : G :=",
